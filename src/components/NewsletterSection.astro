---
/**
 * NewsletterSection — matches the subscribe block on https://valkey.io/download/.
 *
 * Uses the Linux Foundation `valkey-announce` mailing list, same endpoint as
 * the homepage. Kept intentionally simple (email only): the full LF marketing
 * form (country/language/consent) is hosted under the `lists.linuxfoundation.org`
 * subscribe page once submitted.
 */
---

<section class="home-section newsletter-section">
  <div class="width-limiter">
    <h2>Subscribe for updates, event info, and the latest Valkey news</h2>
    <p class="newsletter-lead">
      Stay connected with everything happening in the Valkey ecosystem: news,
      community stories, updates, and opportunities to get involved.
      Subscriptions are open to all, so invite a friend or teammate.
    </p>
    <form
      class="newsletter"
      action="https://lists.linuxfoundation.org/mailman/subscribe/valkey-announce"
      method="POST"
      target="_blank"
    >
      <input
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        aria-label="Email address"
      />
      <button type="submit">Subscribe</button>
    </form>
    <p class="fine-print">
      Powered by the Linux Foundation's mailing list. We won't share your address.
    </p>
  </div>
</section>

<style>
  .newsletter-section {
    padding: 4rem 1.5rem;
    background: linear-gradient(
      135deg,
      var(--valkey-deep-blue, #003b5c),
      var(--valkey-purple-300, #4b1e5f)
    );
    color: #fff;
    text-align: center;
  }
  .newsletter-section h2 {
    font-family: var(--valkey-cond, "Open Sans Condensed", sans-serif);
    color: #fff;
    text-transform: none;
    max-width: 40rem;
    margin: 0 auto 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
  }
  .newsletter-lead {
    max-width: 42rem;
    margin: 0 auto 1.75rem;
    opacity: 0.9;
    font-size: 1rem;
    line-height: 1.5;
  }
  .newsletter {
    display: flex;
    gap: 0.75rem;
    max-width: 520px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .newsletter input {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1rem;
  }
  .newsletter input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }
  .newsletter button {
    padding: 0.75rem 1.5rem;
    background: #fff;
    color: var(--valkey-purple-300, #4b1e5f);
    border: 0;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .newsletter button:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  .fine-print {
    font-size: 0.85rem;
    opacity: 0.8;
    margin-top: 1rem;
  }
</style>
