---
/**
 * ParticipantsStrip — restyled participants carousel with the original
 * brand periwinkle→lavender gradient, but elevated UX:
 *   - white card surface
 *   - logos desaturated by default, full-color on hover (+ lift)
 *   - tabular index ticks
 *   - generous inter-card hairlines
 *
 * Structure + class hooks match the original (carousel.js binds to
 * #homepageParticipantsCarousel and .homepage-participant-card), so the
 * ported carousel behaviour keeps working. The wrapper class
 * `homepage-participants-section` is kept so the existing flex-layout
 * rules from valkey-brand.css still apply.
 */
import { marked } from "marked";

interface Participant {
  name: string;
  image?: { path: string; alt?: string };
  offering?: string;
  company?: string;
  link?: string;
}

export interface Props {
  participants: Participant[];
  title?: string;
  lead?: string;
}

const { participants, title = "Participants", lead } = Astro.props;
const totalSlides = Math.ceil(participants.length / 3);

function blurb(p: Participant): string {
  const src = p.offering ?? p.company ?? "";
  return marked.parse(src, { async: false }) as string;
}
---

<section class="vk-pts homepage-participants-section">
  <div class="vk-pts-frame">
    <header class="vk-pts-head">
      <h2 class="vk-pts-title">{title}</h2>
      {lead && <p class="vk-pts-lead">{lead}</p>}
    </header>

    <div class="vk-pts-surface">
      <div
        class="homepage-participants-carousel-container vk-pts-container"
      >
        <div class="homepage-participants-carousel" id="homepageParticipantsCarousel">
          <div class="homepage-participants-track" id="homepageParticipantsTrack">
            {participants.map((p, i) => (
              <div
                class="homepage-participant-card vk-pts-card"
                onclick={p.link ? `window.open('${p.link}', '_blank')` : undefined}
                role="button"
                tabindex="0"
                aria-label={`Visit ${p.name} website`}
              >
                <div class="homepage-participant-image-container vk-pts-img-wrap">
                  {p.image && p.image.path ? (
                    <img
                      src={p.image.path}
                      alt={p.image.alt || `${p.name} logo`}
                      class="homepage-participant-image vk-pts-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="homepage-participant-image-placeholder">
                      {p.name.slice(0, 2)}
                    </div>
                  )}
                </div>
                <h3 class="homepage-participant-name vk-pts-name">{p.name}</h3>
                <div
                  class="homepage-participant-offering vk-pts-offering"
                  set:html={blurb(p)}
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      <div
        class="homepage-participants-navigation vk-pts-nav"
        aria-label="Participant carousel navigation"
      >
        <div class="homepage-participants-dots" id="homepageParticipantsDots">
          {totalSlides > 1 &&
            Array.from({ length: totalSlides }).map((_, i) => (
              <button
                class="homepage-participant-dot"
                data-slide={i}
                aria-label={`Go to slide ${i + 1}`}
                aria-current="false"
              />
            ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Restore original brand gradient (sass/_valkey.scss used
     `linear-gradient(180deg, #6983ff 0%, #bcb5e7 100%)`). Theme-aware in
     dark mode via `--valkey-section-participants-bg`. */
  .vk-pts {
    background: var(--valkey-section-participants-bg);
    padding: 5rem 1.5rem 5.5rem;
    position: relative;
    isolation: isolate;
  }

  .vk-pts-frame {
    max-width: 1200px;
    margin: 0 auto;
  }

  .vk-pts-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .vk-pts-title {
    margin: 0 0 1rem;
    font-family: var(--valkey-sans, "Open Sans", sans-serif);
    letter-spacing: -0.01em;
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.1;
    font-weight: 700;
  }
  .vk-pts-lead {
    max-width: 58rem;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1rem;
    line-height: 1.6;
  }

  .vk-pts-surface {
    background: var(--valkey-section-participants-card-bg);
    border-radius: 20px;
    padding: 0.5rem;
    box-shadow: 0 30px 80px -40px rgba(48, 24, 110, 0.4);
  }

  /* All selectors below are deliberately prefixed with `.vk-pts ...` to outrank
     the legacy `.homepage-participants-section ...` rules in valkey-brand.css
     (those have specificity up to 0,5,0 — for the navigation dots).
     `.vk-pts .x .y .z .w` reaches 0,5,0 once Astro injects its `data-astro-cid`
     attribute, so we win without `!important`. */

  .vk-pts .vk-pts-container {
    border-radius: 14px;
    overflow: hidden;
  }

  .vk-pts .homepage-participants-carousel .homepage-participant-card {
    padding: 2rem 1.75rem;
    position: relative;
    border-right: 1px solid rgba(48, 24, 110, 0.08);
    transition:
      background 0.25s ease,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .vk-pts .homepage-participants-carousel .homepage-participant-card:hover {
    background: var(--valkey-section-participants-card-hover);
    transform: translateY(-3px);
  }
  .vk-pts .vk-pts-img-wrap {
    margin-bottom: 1.25rem;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vk-pts .vk-pts-img {
    filter: grayscale(100%) contrast(0.9);
    opacity: 0.72;
    transition: filter 0.25s ease, opacity 0.25s ease;
    max-height: 44px;
  }
  .vk-pts .homepage-participant-card:hover .vk-pts-img {
    filter: grayscale(0%);
    opacity: 1;
  }
  .vk-pts .homepage-participants-carousel .homepage-participant-card .vk-pts-name {
    font-family: var(--valkey-sans, "Open Sans", sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--valkey-text-strong, #003b5c);
  }
  .vk-pts .homepage-participants-carousel .homepage-participant-card .vk-pts-offering {
    font-size: 0.82rem;
    color: var(--valkey-text-light, #647782);
  }

  .vk-pts .vk-pts-nav {
    margin-top: 1.5rem;
  }
  .vk-pts .homepage-participants-navigation .homepage-participants-dots .homepage-participant-dot {
    background: rgba(255, 255, 255, 0.5);
    width: 8px;
    height: 8px;
  }
  .vk-pts .homepage-participants-navigation .homepage-participants-dots .homepage-participant-dot[aria-current="true"],
  .vk-pts .homepage-participants-navigation .homepage-participants-dots .homepage-participant-dot.active {
    background: #fff;
  }

  @media (max-width: 768px) {
    .vk-pts { padding: 3.5rem 1.25rem 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vk-pts .homepage-participants-carousel .homepage-participant-card,
    .vk-pts-img {
      transition: none;
    }
  }
</style>
