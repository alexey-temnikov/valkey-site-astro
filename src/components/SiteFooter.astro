---
// Footer ported from valkey.io. Scarf pixel + GTM noscript live in
// MarketingLayout (PROD-gated); don't duplicate them here.
---

<!-- Row 1: socials + nav links -->
<div class="footer" data-pagefind-ignore>
  <div class="row">
    <div class="col col-6 icon-links">
      <a href="https://valkey.io/slack" target="_blank">
        <img src="/img/IconSlack.svg" alt="Slack Icon" width="20" height="20" />
        Slack
      </a>
      <a href="https://github.com/valkey-io" target="_blank">
        <img src="/img/IconGithub.svg" alt="GitHub Icon" width="20" height="20" />
        GitHub
      </a>
      <a href="https://www.linkedin.com/company/valkey/" target="_blank">
        <img src="/img/IconLinkedin.svg" alt="LinkedIn Icon" width="20" height="20" />
        LinkedIn
      </a>
      <a href="https://x.com/valkey_io" target="_blank">
        <img src="/img/IconX.svg" alt="X Icon" width="20" height="20" />
        X.com
      </a>
      <a href="/connect">
        <img src="/img/IconMail.svg" alt="Mail Icon" width="20" height="20" />
        Connect
      </a>
    </div>
    <div class="col col-6 links">
      <a href="/code_of_conduct">Code of Conduct</a>
      <a href="/community/meetup-groups/">Meetup Groups</a>
      <a href="https://github.com/orgs/valkey-io/discussions" target="_blank">Forum</a>
      <a href="/about">About</a>
      <a href="/leadership">Leadership</a>
      <a href="/topics/faq">FAQ</a>
    </div>
  </div>
</div>

<!-- Row 2: HubSpot newsletter form (matches templates/includes/email-list.html) -->
<div class="footer" data-pagefind-ignore>
  <div class="row">
    <div class="row footer-email-list" id="email-signup">
      <div class="col col-4">
        <h2>Subscribe for updates, event info, and the latest Valkey news</h2>
        <p>Stay connected with everything happening in the Valkey ecosystem: news, community stories, updates, and opportunities to get involved.</p>
        <p>Subscriptions are open to all, so invite a friend or teammate. Thanks for joining and happy reading!</p>
      </div>
      <div class="footer-form col col-8">
        <script is:inline charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
        <script is:inline>
          (function () {
            function createForm() {
              if (window.hbspt && window.hbspt.forms && window.hbspt.forms.create) {
                window.hbspt.forms.create({
                  portalId: "8112310",
                  formId: "7d793edf-4628-41c5-8c66-1a40a5b345b6",
                  region: "na1",
                  target: "#valkey-hubspot-form",
                });
              } else {
                setTimeout(createForm, 100);
              }
            }
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", createForm);
            } else {
              createForm();
            }
          })();
        </script>
        <div id="valkey-hubspot-form"></div>
      </div>
    </div>
  </div>
</div>

<!-- Row 3: legal / copyright -->
<div class="footer" data-pagefind-ignore>
  <div class="footer_bottom">
    <p>© Valkey contributors.</p>
    <p>Valkey and the Valkey logo are trademarks of LF Projects, LLC.</p>
    <p>
      <a href="https://lfprojects.org/policies/trademark-policy/">Trademark Policy</a>.
      <a href="https://lfprojects.org/policies/privacy-policy/">Privacy Policy</a>.
      <a href="https://lfprojects.org/policies/terms-of-use/">Terms of Use</a>.
      For other policies, please see <a href="https://lfprojects.org/">lfprojects.org</a>.
    </p>
    <p>Valkey includes certain 3-Clause BSD-licensed Redis code from Redis Ltd. and other source code. Redis Ltd. is
      not the source of that other source code. Redis is a registered trademark of Redis Ltd.</p>
    <p>
      Logo design by <a href="https://github.com/dizys" target="_blank">Ziyang.</a>
    </p>
  </div>
</div>

<style is:global>
  /* ====================================================================
     Footer — ported from valkey-io.github.io/sass/_valkey.scss:391-478.
     Footer surface always renders dark so it just deepens slightly when
     the rest of the page goes dark. `--valkey-footer-bg` is the variable.
     ==================================================================== */
  .footer {
    background-color: var(--valkey-footer-bg, #1a2026);
    font-family: var(--valkey-sans, "Open Sans", "Segoe UI", Tahoma, sans-serif);
    font-size: 14px;
    color: #fff;
    padding: 20px 0;
  }
  .footer + .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer .icon-links {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .footer .icon-links a {
    display: flex;
    align-items: center;
    color: #fff;
    text-decoration: none;
  }
  .footer .icon-links a:hover {
    color: #fff;
    text-decoration: underline;
    opacity: 0.8;
  }
  .footer .icon-links a img {
    margin-right: 5px;
  }
  @media screen and (min-width: 768px) {
    .footer .icon-links {
      flex-direction: row;
      border: none;
    }
  }

  .footer .links {
    display: flex;
    flex-direction: column;
    gap: 15px;
    justify-content: flex-end;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 20px;
    padding-top: 20px;
  }
  .footer .links a {
    color: #fff;
    text-decoration: underline;
  }
  .footer .links a:hover {
    opacity: 0.8;
  }
  @media screen and (min-width: 768px) {
    .footer .links {
      flex-direction: row;
      border: none;
      margin-top: 0;
      padding-top: 0;
    }
  }

  .footer_bottom {
    width: 100%;
    margin-top: 20px;
    padding: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }
  .footer_bottom p {
    max-width: 720px;
    margin: 8px auto;
  }
  .footer_bottom a {
    color: #6983ff;
    text-decoration: none;
  }
  .footer_bottom a:hover {
    text-decoration: underline;
  }

  /* ====================================================================
     Grid — ported from _valkey.scss:738-788
     ==================================================================== */
  .footer .row,
  .footer .row .col {
    box-sizing: border-box;
  }
  .footer .row {
    display: flex;
    margin: 0 auto;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1400px;
  }
  .footer .row .col {
    flex: 1 1 100%;
    padding-left: 20px;
    padding-right: 20px;
  }
  @media screen and (min-width: 768px) {
    .footer .row .col-8 { flex: 1 1 66.66%; }
    .footer .row .col-6 { flex: 1 1 50%;    }
    .footer .row .col-4 { flex: 1 1 33.33%; }
  }

  /* ====================================================================
     HubSpot newsletter — ported verbatim from _email-form.scss
     ==================================================================== */
  .footer-email-list {
    margin-top: 20px;
    margin-bottom: 10px;
    text-align: left;
  }
  .footer-email-list h2 {
    margin-top: 0;
    font-weight: 350;
    font-size: 1.5rem;
  }
  .footer-email-list p {
    font-weight: 300;
  }
  .footer-form div.field {
    text-align: left;
  }
  .footer-form .legal-consent-container,
  .footer-form .hs-richtext {
    text-align: left;
  }
  .footer-form .legal-consent-container p,
  .footer-form .hs-richtext p {
    max-width: none;
    margin: auto;
  }
  .footer-form input[type="submit"] {
    background: none;
    border: 1px solid white;
    color: white;
    padding: 0.5em 2em;
    cursor: pointer;
  }
  .footer-form .actions {
    text-align: left;
  }
  .footer-form .hs_submit {
    padding-top: 1em;
    height: 100px; /* this is due to the floating captcha badge */
  }
  .footer-form .hs_recaptcha {
    float: right;
    opacity: 0.5;
    min-height: 60px;
  }
  .footer-form .hs-error-msgs {
    list-style-type: none;
    color: red;
    padding-left: 0;
    margin-top: 0;
  }
  .footer-form input[type="text"],
  .footer-form input[type="email"],
  .footer-form select {
    background: none;
    border: none;
    border-bottom: 1px solid white;
    color: white;
    width: 100%;
    margin-bottom: 0.75em;
  }
  .footer-form input[type="text"]::placeholder,
  .footer-form input[type="email"]::placeholder,
  .footer-form select::placeholder {
    opacity: 1;
    color: white;
  }
  .footer-form select {
    color: white;
  }
  /* Select options need dark text on white OS menu */
  .footer-form select option {
    color: #000;
  }
</style>
