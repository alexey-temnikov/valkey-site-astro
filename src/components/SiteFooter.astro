---
// Footer ported verbatim from valkey.io (Zola reference).
// Source: valkey-io.github.io/templates/default.html + templates/includes/email-list.html
// Do not simplify or paraphrase — match the reference 1-1.
const isProd = import.meta.env.PROD;
---

<!-- Row 1: socials + nav links -->
<div class="footer" data-pagefind-ignore>
  <div class="row">
    <div class="col col-6 icon-links">
      <a href="https://valkey.io/slack" target="_blank">
        <img src="/img/IconSlack.svg" alt="Slack Icon" width="20" height="20" />
        Slack
      </a>
      <a href="https://github.com/valkey-io" target="_blank">
        <img src="/img/IconGithub.svg" alt="GitHub Icon" width="20" height="20" />
        GitHub
      </a>
      <a href="https://www.linkedin.com/company/valkey/" target="_blank">
        <img src="/img/IconLinkedin.svg" alt="LinkedIn Icon" width="20" height="20" />
        LinkedIn
      </a>
      <a href="https://x.com/valkey_io" target="_blank">
        <img src="/img/IconX.svg" alt="X Icon" width="20" height="20" />
        X.com
      </a>
      <a href="/connect">
        <img src="/img/IconMail.svg" alt="Mail Icon" width="20" height="20" />
        Connect
      </a>
    </div>
    <div class="col col-6 links">
      <a href="/code_of_conduct">Code of Conduct</a>
      <a href="/community/meetup-groups/">Meetup Groups</a>
      <a href="https://github.com/orgs/valkey-io/discussions" target="_blank">Forum</a>
      <a href="/about">About</a>
      <a href="/leadership">Leadership</a>
      <a href="/topics/faq">FAQ</a>
    </div>
  </div>
</div>

<!-- Row 2: HubSpot newsletter form (matches templates/includes/email-list.html) -->
<div class="footer" data-pagefind-ignore>
  <div class="row">
    <div class="row footer-email-list" id="email-signup">
      <div class="col col-4">
        <h2>Subscribe for updates, event info, and the latest Valkey news</h2>
        <p>Stay connected with everything happening in the Valkey ecosystem: news, community stories, updates, and opportunities to get involved.</p>
        <p>Subscriptions are open to all, so invite a friend or teammate. Thanks for joining and happy reading!</p>
      </div>
      <div class="footer-form col col-8">
        <script is:inline charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
        <script is:inline>
          (function () {
            function createForm() {
              if (window.hbspt && window.hbspt.forms && window.hbspt.forms.create) {
                window.hbspt.forms.create({
                  portalId: "8112310",
                  formId: "7d793edf-4628-41c5-8c66-1a40a5b345b6",
                  region: "na1",
                  target: "#valkey-hubspot-form",
                });
              } else {
                setTimeout(createForm, 100);
              }
            }
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", createForm);
            } else {
              createForm();
            }
          })();
        </script>
        <div id="valkey-hubspot-form"></div>
      </div>
    </div>
  </div>
</div>

<!-- Row 3: legal / copyright -->
<div class="footer" data-pagefind-ignore>
  <div class="footer_bottom">
    <p>© Valkey contributors.</p>
    <p>Valkey and the Valkey logo are trademarks of LF Projects, LLC.</p>
    <p>
      <a href="https://lfprojects.org/policies/trademark-policy/">Trademark Policy</a>.
      <a href="https://lfprojects.org/policies/privacy-policy/">Privacy Policy</a>.
      <a href="https://lfprojects.org/policies/terms-of-use/">Terms of Use</a>.
      For other policies, please see <a href="https://lfprojects.org/">lfprojects.org</a>.
    </p>
    <p>Valkey includes certain 3-Clause BSD-licensed Redis code from Redis Ltd. and other source code. Redis Ltd. is
      not the source of that other source code. Redis is a registered trademark of Redis Ltd.</p>
    <p>
      Logo design by <a href="https://github.com/dizys" target="_blank">Ziyang.</a>
    </p>
  </div>
  <img referrerpolicy="no-referrer-when-downgrade" src="https://static.scarf.sh/a.png?x-pxid=4682283c-f8b7-410c-9c31-c6d7944cee8b" alt="" />
  {isProd && (
    <Fragment set:html={`<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MFFCB7SR"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->`} />
  )}
</div>

<style is:global>
  /* Footer styles — ported from valkey.io stylesheet */
  .footer {
    background: var(--valkey-deep-blue, #0b1628);
    color: #b3c2cb;
    padding: 2rem 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Row layout */
  .footer > .row {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .footer .col {
    flex: 1 1 auto;
  }
  .footer .col-4 { flex-basis: 33%; }
  .footer .col-6 { flex-basis: calc(50% - 1rem); }
  .footer .col-8 { flex-basis: 66%; }

  /* Row 1: socials + text links */
  .footer .icon-links,
  .footer .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .footer .links { justify-content: flex-end; }
  .footer .icon-links a,
  .footer .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #b3c2cb;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .footer .icon-links a:hover,
  .footer .links a:hover {
    color: #fff;
    text-decoration: none;
  }
  .footer .icon-links img {
    filter: brightness(0) invert(1);
  }

  /* Row 2: email list (HubSpot) */
  .footer-email-list {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    width: 100%;
  }
  .footer-email-list h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    color: #fff;
    line-height: 1.25;
  }
  .footer-email-list p {
    color: #b3c2cb;
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }
  .footer-form {
    color: #e7eef3;
  }
  .footer-form .hs-form-field {
    margin-bottom: 0.85rem;
  }
  .footer-form label {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
    color: #b3c2cb;
  }
  .footer-form .hs-form-required {
    color: #ff5a6b;
    margin-left: 0.15rem;
  }
  .footer-form input[type="text"],
  .footer-form input[type="email"],
  .footer-form select {
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: transparent;
    color: #fff;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    font-size: 0.95rem;
    outline: none;
  }
  .footer-form input:focus,
  .footer-form select:focus {
    border-bottom-color: #fff;
  }
  .footer-form select option {
    color: #000;
  }
  .footer-form .hs-submit .hs-button {
    background: transparent;
    color: #fff;
    border: 1px solid #fff;
    padding: 0.55rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 2px;
  }
  .footer-form .hs-submit .hs-button:hover {
    background: #fff;
    color: var(--valkey-deep-blue, #0b1628);
  }
  .footer-form .legal-consent-container,
  .footer-form .hs-richtext {
    font-size: 0.8rem;
    color: #b3c2cb;
    margin: 0.75rem 0;
    line-height: 1.4;
  }
  .footer-form .legal-consent-container a {
    color: #5ea5f5;
  }
  .footer-form .hs-error-msgs {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    color: #ff5a6b;
    font-size: 0.75rem;
  }

  /* Row 3: legal */
  .footer_bottom {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    padding: 0.75rem 0;
  }
  .footer_bottom p {
    margin: 0.5rem 0;
    font-size: 0.85rem;
    color: #8d9aa4;
    line-height: 1.55;
  }
  .footer_bottom a {
    color: #8d9aa4;
    text-decoration: underline;
  }
  .footer_bottom a:hover {
    color: #fff;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .footer > .row { flex-direction: column; align-items: stretch; }
    .footer .col-6, .footer .col-4, .footer .col-8 { flex-basis: 100%; }
    .footer .icon-links, .footer .links { justify-content: center; }
  }
</style>
