---
// Announcement banner, dismissible for 24 hours via localStorage.
export interface Props {
  message?: string;
  linkText?: string;
  linkUrl?: string;
}
const {
  message = "What's new in Valkey 9.0?",
  linkText = "Read the announcement",
  linkUrl = "/blog/introducing-valkey-9/",
} = Astro.props;
---

{/* Banner visibility is decided by the pre-paint script in
    MarketingLayout (and Starlight's <Banner> slot uses the same key).
    The script sets `.banner-dismissed` on <html> *before* first paint;
    CSS then hides the banner via that class — no JS-driven layout
    shift after the HTML parses. */}
<div class="announcement-banner" id="announcement-banner" data-pagefind-ignore>
  <div class="width-limiter">
    <strong>{message}</strong>
    <span> Discover new features and improvements. </span>
    <a href={linkUrl}>{linkText}</a>.
  </div>
  <button class="close" aria-label="Dismiss announcement" id="close-banner">×</button>
</div>

<script is:inline>
  (function () {
    const KEY = "valkey:banner:closedAt";
    const btn = document.getElementById("close-banner");
    btn?.addEventListener("click", () => {
      try { localStorage.setItem(KEY, String(Date.now())); } catch {}
      document.documentElement.classList.add("banner-dismissed");
    });
  })();
</script>
