---
/**
 * ValkeyTerminal — an animated valkey-cli session for the hero.
 *
 * Renders a semi-realistic terminal frame with a rotating script of
 * SET / GET / HSET / CLUSTER INFO commands and their plausible responses.
 * Typing is driven entirely by an inline script so the HTML is server-
 * rendered static text (no CLS, no React runtime cost, no hydration).
 *
 * All lines are plausible but synthetic — they don't need to match any
 * real server's response, they need to *look* like a database.
 */
---

<div
  class="vk-terminal"
  role="img"
  aria-label="Animated valkey-cli session showing SET, GET, HSET, and CLUSTER INFO commands"
>
  <div class="vk-terminal-chrome" aria-hidden="true">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
    <span class="title">valkey-cli ⏵ 127.0.0.1:6379</span>
    <span class="region">us-east-1 · p99 0.12ms</span>
  </div>

  <pre class="vk-terminal-body" id="vk-terminal-output"><span class="prompt"
    >valkey&gt;</span> <span class="typed" id="vk-typed-line"></span><span
      class="cursor"
      aria-hidden="true"
    >▌</span>
<span class="vk-terminal-history" id="vk-terminal-history" aria-live="polite"></span></pre>
</div>

<script is:inline>
  (() => {
    const output = document.getElementById("vk-terminal-output");
    const typedEl = document.getElementById("vk-typed-line");
    const historyEl = document.getElementById("vk-terminal-history");
    if (!output || !typedEl || !historyEl) return;

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Each scene is a [command, response-lines] pair.
    const scenes = [
      [
        "SET session:42 '{\"user\":\"ada\"}' EX 3600",
        ["<span class='ok'>OK</span>"],
      ],
      [
        "GET session:42",
        ["<span class='str'>\"{\\\"user\\\":\\\"ada\\\"}\"</span>"],
      ],
      [
        "HSET leaderboard:2026 alice 128400 bob 127300 eve 126010",
        ["<span class='int'>(integer) 3</span>"],
      ],
      [
        "ZADD requests:us-east-1 1731087234 req-91a4",
        ["<span class='int'>(integer) 1</span>"],
      ],
      [
        "XADD events:orders * sku SKU-8472 qty 3",
        ["<span class='str'>\"1731087301-0\"</span>"],
      ],
      [
        "CLUSTER INFO",
        [
          "<span class='key'>cluster_state</span>:<span class='ok'>ok</span>",
          "<span class='key'>cluster_slots_assigned</span>:<span class='int'>16384</span>",
          "<span class='key'>cluster_known_nodes</span>:<span class='int'>6</span>",
          "<span class='key'>cluster_size</span>:<span class='int'>3</span>",
        ],
      ],
    ];

    const PROMPT = "valkey&gt; ";

    const pushHistory = (commandHtml, responseLines) => {
      const block = document.createElement("span");
      block.className = "line";
      block.innerHTML =
        `<span class='prompt'>valkey&gt;</span> <span class='typed'>${commandHtml}</span>\n` +
        responseLines.join("\n") +
        "\n\n";
      historyEl.appendChild(block);
      // Trim so the terminal doesn't grow forever (keep ~2 scenes)
      while (historyEl.childElementCount > 2) historyEl.firstChild.remove();
    };

    const escapeHtml = (s) =>
      s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]);

    // Highlight a typed command fragment (very light SQL-ish tokenisation).
    const colorize = (fragment) => {
      const kw = /^(SET|GET|HSET|HGETALL|ZADD|ZRANGE|XADD|XRANGE|CLUSTER|INFO|EX|EXPIRE|DEL|KEYS|PING|DBSIZE|SCAN|LPUSH|RPUSH|LRANGE)\b/i;
      return escapeHtml(fragment).replace(/(\S+)/g, (_, tok) => {
        if (kw.test(tok)) return `<span class='kw'>${tok}</span>`;
        if (/^['"].*['"]$/.test(tok)) return `<span class='str'>${tok}</span>`;
        if (/^\d+$/.test(tok)) return `<span class='int'>${tok}</span>`;
        if (/^[a-z0-9_-]+:[a-z0-9:_-]+/i.test(tok)) return `<span class='key'>${tok}</span>`;
        return tok;
      });
    };

    let scene = 0;
    const runScene = async () => {
      const [cmd, lines] = scenes[scene % scenes.length];
      typedEl.innerHTML = "";
      // type char-by-char
      for (let i = 0; i < cmd.length; i++) {
        typedEl.innerHTML = colorize(cmd.slice(0, i + 1));
        await sleep(prefersReduced ? 0 : 22 + Math.random() * 30);
      }
      await sleep(prefersReduced ? 0 : 280);
      pushHistory(colorize(cmd), lines);
      typedEl.textContent = "";
      await sleep(prefersReduced ? 0 : 1400);
      scene++;
      if (!document.hidden) runScene();
    };

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    // Only start typing when the terminal is actually in view; pause when off.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) runScene();
      },
      { threshold: 0.3 },
    );
    io.observe(output);
  })();
</script>

<style>
  .vk-terminal {
    --vk-term-bg: #1a0e38;
    --vk-term-fg: #e5ddf7;
    --vk-term-muted: #a391c9;
    --vk-term-accent: #c2d4ff;
    --vk-term-green: #7cd1a0;
    --vk-term-yellow: #ffcf6f;
    --vk-term-purple: #e0c8ff;

    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    background: var(--vk-term-bg);
    color: var(--vk-term-fg);
    overflow: hidden;
    box-shadow:
      0 30px 60px rgba(18, 5, 48, 0.55),
      0 2px 0 rgba(255, 255, 255, 0.04) inset;
    position: relative;
  }
  .vk-terminal::before {
    /* subtle scanline / grain overlay, pure CSS */
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.015) 0 1px,
      transparent 1px 3px
    );
    mix-blend-mode: overlay;
  }

  .vk-terminal-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #271458 0%, #170930 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.72rem;
    color: var(--vk-term-muted);
    letter-spacing: 0.04em;
  }
  .vk-terminal-chrome .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex: 0 0 auto;
  }
  .vk-terminal-chrome .dot-r { background: #ff5f57; }
  .vk-terminal-chrome .dot-y { background: #febc2e; }
  .vk-terminal-chrome .dot-g { background: #28c840; margin-right: 0.85rem; }
  .vk-terminal-chrome .title { color: #8faac2; }
  .vk-terminal-chrome .region {
    margin-left: auto;
    color: var(--vk-term-accent);
    font-variant-numeric: tabular-nums;
  }

  .vk-terminal-body {
    margin: 0;
    padding: 1.1rem 1.25rem 1.25rem;
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.88rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 15rem;
    position: relative;
  }

  .vk-terminal-body .prompt {
    color: var(--vk-term-accent);
    user-select: none;
  }
  .vk-terminal-body .typed {
    color: var(--vk-term-fg);
  }
  .vk-terminal-body .cursor {
    color: var(--vk-term-accent);
    animation: vk-blink 1s steps(1) infinite;
    display: inline-block;
    transform: translateX(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .vk-terminal-body .cursor { animation: none; opacity: 0.6; }
  }
  @keyframes vk-blink {
    50% { opacity: 0; }
  }

  /* Token colors used by the inline script */
  .vk-terminal-body :global(.kw)  { color: var(--vk-term-purple); font-weight: 600; }
  .vk-terminal-body :global(.str) { color: var(--vk-term-yellow); }
  .vk-terminal-body :global(.int) { color: #ffd7b0; }
  .vk-terminal-body :global(.key) { color: var(--vk-term-accent); }
  .vk-terminal-body :global(.ok)  { color: var(--vk-term-green); font-weight: 600; }

  /* History block */
  .vk-terminal-body .vk-terminal-history {
    display: block;
    color: var(--vk-term-muted);
    opacity: 0.85;
  }
  .vk-terminal-body .vk-terminal-history :global(.line) {
    display: block;
  }

  @media (max-width: 680px) {
    .vk-terminal-chrome { font-size: 0.65rem; padding: 0.5rem 0.7rem; }
    .vk-terminal-chrome .region { display: none; }
    .vk-terminal-body { font-size: 0.8rem; padding: 0.9rem 1rem 1rem; min-height: 12rem; }
  }
</style>
