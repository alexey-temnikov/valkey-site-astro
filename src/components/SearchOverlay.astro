---
// Site-wide search overlay using PagefindUI.
// Mounted once in SiteHeader, so every page (marketing + Starlight) gets the
// same ⌘K experience from the same Pagefind index at /pagefind/.
//
// Assumes the Pagefind index has been built into /pagefind/ by `pnpm build`.
// In `pnpm dev` the index doesn't exist yet and the overlay shows a hint.
---

<dialog id="search-overlay" class="search-overlay" aria-label="Search the site" data-pagefind-ignore>
  <div class="search-overlay-panel">
    <button
      type="button"
      class="search-overlay-close"
      aria-label="Close search"
      data-close-search
    >×</button>
    <div id="pagefind-search-ui"></div>
    <p class="search-overlay-hint" id="search-overlay-hint" hidden>
      Search index not built yet. Run <code>pnpm build</code>, then <code>pnpm preview</code>.
    </p>
  </div>
</dialog>

<script is:inline>
  (function () {
    const dialog = document.getElementById("search-overlay");
    const hint = document.getElementById("search-overlay-hint");
    if (!dialog) return;

    let initialized = false;
    let initPromise = null;

    function loadPagefindUi() {
      if (initPromise) return initPromise;
      initPromise = new Promise((resolve, reject) => {
        // Pagefind ships its own CSS — load it once.
        if (!document.querySelector('link[href="/pagefind/pagefind-ui.css"]')) {
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/pagefind/pagefind-ui.css";
          document.head.appendChild(link);
        }
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
      return initPromise;
    }

    async function init() {
      if (initialized) return true;
      try {
        await loadPagefindUi();
      } catch {
        if (hint) hint.hidden = false;
        return false;
      }
      if (typeof PagefindUI === "undefined") {
        if (hint) hint.hidden = false;
        return false;
      }
      // eslint-disable-next-line no-undef
      new PagefindUI({
        element: "#pagefind-search-ui",
        resetStyles: false,
        showSubResults: true,
        showImages: false,
      });
      initialized = true;
      return true;
    }

    async function open() {
      const ok = await init();
      // <dialog>.showModal throws if already open — guard with `open` attr.
      if (!dialog.open) dialog.showModal();
      if (ok) {
        // Focus the input after Pagefind renders it.
        requestAnimationFrame(() => {
          const input = dialog.querySelector(".pagefind-ui__search-input");
          if (input) input.focus();
        });
      }
    }

    function close() {
      if (dialog.open) dialog.close();
    }

    // Close on backdrop click (clicking the dialog element itself, not the panel).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    // Close when any [data-close-search] element is clicked.
    dialog.addEventListener("click", (e) => {
      const t = e.target;
      if (t && t.closest && t.closest("[data-close-search]")) close();
    });

    // Global keyboard shortcut.
    window.addEventListener("keydown", (e) => {
      const isMod = e.metaKey || e.ctrlKey;
      if (isMod && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        open();
      }
    });

    // Wire up any button with [data-open-search].
    document.addEventListener("click", (e) => {
      const t = e.target;
      if (t && t.closest && t.closest("[data-open-search]")) {
        e.preventDefault();
        open();
      }
    });

    // Expose programmatic control for other scripts.
    window.__valkeySearch = { open, close };
  })();
</script>

<style>
  .search-overlay {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(640px, calc(100vw - 2rem));
    width: 100%;
    margin: 10vh auto auto;
  }
  .search-overlay::backdrop {
    background: rgba(10, 20, 30, 0.55);
    backdrop-filter: blur(2px);
  }
  .search-overlay-panel {
    position: relative;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    padding: 1.25rem 1.25rem 1rem;
  }
  .search-overlay-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: transparent;
    border: 0;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: var(--valkey-text-light, #555);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  .search-overlay-close:hover {
    background: var(--valkey-bg-soft, #f4f6f8);
    color: var(--valkey-text, #111);
  }
  .search-overlay-hint {
    margin: 1rem 0 0;
    color: var(--valkey-text-light, #555);
    font-size: 0.9rem;
  }
  .search-overlay-hint code {
    background: var(--valkey-bg-soft, #f4f6f8);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: var(--valkey-mono, ui-monospace, monospace);
  }

  /* Light brand polish on Pagefind's default UI (works with resetStyles:false). */
  .search-overlay :global(.pagefind-ui__search-input) {
    border: 1px solid var(--valkey-line, #d9dde2);
    border-radius: 8px;
  }
  .search-overlay :global(.pagefind-ui__search-input:focus-visible) {
    outline: 2px solid var(--valkey-blue-300, #2574a9);
    outline-offset: 1px;
  }
  .search-overlay :global(.pagefind-ui__result-link) {
    color: var(--valkey-deep-blue, #0a2233);
    font-weight: 600;
  }
</style>
