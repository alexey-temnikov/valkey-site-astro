---
// Site-wide search overlay using PagefindUI.
// Mounted once in SiteHeader, so every page (marketing + Starlight) gets the
// same ⌘K experience from the same Pagefind index at /pagefind/.
//
// Assumes the Pagefind index has been built into /pagefind/ by `pnpm build`.
// In `pnpm dev` the index doesn't exist yet and the overlay shows a hint.
---

<dialog id="search-overlay" class="search-overlay" aria-label="Search the site" data-pagefind-ignore>
  <div class="search-overlay-panel">
    <button
      type="button"
      class="search-overlay-close"
      aria-label="Close search"
      data-close-search
    >×</button>
    <div id="pagefind-search-ui"></div>
    <p class="search-overlay-hint" id="search-overlay-hint" hidden>
      Search index not built yet. Run <code>pnpm build</code>, then <code>pnpm preview</code>.
    </p>
    <div class="search-overlay-foot" aria-hidden="true">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    const dialog = document.getElementById("search-overlay");
    const hint = document.getElementById("search-overlay-hint");
    if (!dialog) return;

    let initialized = false;
    let initPromise = null;

    function loadPagefindUi() {
      if (initPromise) return initPromise;
      initPromise = new Promise((resolve, reject) => {
        // Pagefind ships its own CSS — load it once.
        if (!document.querySelector('link[href="/pagefind/pagefind-ui.css"]')) {
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/pagefind/pagefind-ui.css";
          document.head.appendChild(link);
        }
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
      return initPromise;
    }

    async function init() {
      if (initialized) return true;
      try {
        await loadPagefindUi();
      } catch {
        if (hint) hint.hidden = false;
        return false;
      }
      if (typeof PagefindUI === "undefined") {
        if (hint) hint.hidden = false;
        return false;
      }
      // eslint-disable-next-line no-undef
      new PagefindUI({
        element: "#pagefind-search-ui",
        resetStyles: false,
        showSubResults: true,
        showImages: false,
      });
      initialized = true;
      return true;
    }

    async function open() {
      const ok = await init();
      // <dialog>.showModal throws if already open — guard with `open` attr.
      if (!dialog.open) dialog.showModal();
      if (ok) {
        // Focus the input after Pagefind renders it.
        requestAnimationFrame(() => {
          const input = dialog.querySelector(".pagefind-ui__search-input");
          if (input) input.focus();
        });
      }
    }

    function close() {
      if (dialog.open) dialog.close();
    }

    // --- Keyboard navigation between results ---
    // ↑/↓ moves a visual "aria-selected" focus through .pagefind-ui__result-link
    // ↵ opens the currently selected link
    function getLinks() {
      return [...dialog.querySelectorAll(".pagefind-ui__result-link")];
    }
    function clearSelected() {
      dialog.querySelectorAll("[data-vk-selected]").forEach((el) => {
        el.removeAttribute("data-vk-selected");
      });
    }
    function setSelected(i, links) {
      clearSelected();
      const link = links[i];
      if (!link) return;
      link.setAttribute("data-vk-selected", "true");
      // Ensure the selected item is visible in the scroll drawer
      link.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }
    function moveSelection(delta) {
      const links = getLinks();
      if (!links.length) return;
      const current = links.findIndex((l) =>
        l.hasAttribute("data-vk-selected")
      );
      let next = current + delta;
      if (next < 0) next = links.length - 1;
      if (next >= links.length) next = 0;
      setSelected(next, links);
    }

    // Close on backdrop click (clicking the dialog element itself, not the panel).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    // Close when any [data-close-search] element is clicked.
    dialog.addEventListener("click", (e) => {
      const t = e.target;
      if (t && t.closest && t.closest("[data-close-search]")) close();
    });

    // Dialog-scoped keyboard handler for arrow keys + enter.
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        moveSelection(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        moveSelection(-1);
      } else if (e.key === "Enter") {
        const sel = dialog.querySelector("[data-vk-selected]");
        if (sel) {
          e.preventDefault();
          sel.click();
        }
      }
    });

    // Reset selection when the RESULT LIST itself gets replaced (new query),
    // not on any dialog mutation.
    const mo = new MutationObserver(() => clearSelected());
    const startWatching = () => {
      const area = dialog.querySelector(".pagefind-ui__results-area");
      if (area) mo.observe(area, { childList: true });
    };
    // Wait for Pagefind to mount before watching.
    const watchTimer = setInterval(() => {
      if (dialog.querySelector(".pagefind-ui__results-area")) {
        startWatching();
        clearInterval(watchTimer);
      }
    }, 100);

    // Global keyboard shortcut.
    window.addEventListener("keydown", (e) => {
      const isMod = e.metaKey || e.ctrlKey;
      if (isMod && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        open();
      }
    });

    // Wire up any button with [data-open-search].
    document.addEventListener("click", (e) => {
      const t = e.target;
      if (t && t.closest && t.closest("[data-open-search]")) {
        e.preventDefault();
        open();
      }
    });

    // Expose programmatic control for other scripts.
    window.__valkeySearch = { open, close };
  })();
</script>

<style>
  /* Dialog: a fixed-size window that clips its content.
     The scrolling happens *inside* the Pagefind drawer, not on the dialog. */
  .search-overlay {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(720px, calc(100vw - 2rem));
    max-width: 720px;
    /* dvh = dynamic viewport height, correctly accounts for mobile toolbars */
    height: min(720px, 85vh);
    max-height: 85dvh;
    max-height: 85vh;
    margin: 8vh auto auto;
    overflow: hidden;
    border-radius: 14px;
  }
  .search-overlay::backdrop {
    background: rgba(10, 20, 30, 0.55);
    backdrop-filter: blur(2px);
  }
  /* Panel: flex column. Panel fills the dialog; the drawer inside scrolls. */
  .search-overlay-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
    height: 100%;
    overflow: hidden;
    padding: 0;
  }
  .search-overlay-close {
    position: absolute;
    z-index: 10;
    top: 10px;
    right: 10px;
    background: #fff;
    border: 1px solid var(--valkey-line, #d9dde2);
    color: var(--valkey-text-light, #647782);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    border-radius: 999px;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .search-overlay-close:hover {
    background: var(--valkey-bg-soft, #f4f6f8);
    color: var(--valkey-text, #111);
    border-color: var(--valkey-blue-300, #0055a6);
  }
  .search-overlay-close:focus-visible {
    outline: 2px solid var(--valkey-blue-300, #0055a6);
    outline-offset: 2px;
  }
  .search-overlay-hint {
    margin: 1rem;
    color: var(--valkey-text-light, #555);
    font-size: 0.9rem;
  }
  .search-overlay-hint code {
    background: var(--valkey-bg-soft, #f4f6f8);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: var(--valkey-mono, ui-monospace, monospace);
  }
  /* Footer with keyboard hints — sticky at bottom of the panel. */
  .search-overlay-foot {
    flex: none;
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--valkey-line, #d9dde2);
    background: var(--valkey-bg-soft, #f4f6f8);
    color: var(--valkey-text-light, #647782);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    flex-wrap: wrap;
  }
  .search-overlay-foot kbd {
    font-family: var(--valkey-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: #fff;
    border: 1px solid var(--valkey-line, #d9dde2);
    box-shadow: 0 1px 0 var(--valkey-line, #d9dde2);
    color: var(--valkey-text, #111);
  }

  /* --- Pagefind UI layered into the flex column ---------------------- */
  /* Propagate flex-column so the drawer can be the only scroller. */
  .search-overlay :global(#pagefind-search-ui),
  .search-overlay :global(#pagefind-search-ui > .pagefind-ui),
  .search-overlay :global(.pagefind-ui__form) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0; /* allows nested flex child to shrink */
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
  }
  /* Put horizontal spacing on the FORM, so Pagefind's width:100% input fits */
  .search-overlay :global(.pagefind-ui__form) {
    padding: 1rem 3rem 0.75rem 1rem; /* right = room for close button */
  }
  /* Reset the Pagefind search icon positioning for our new padded form */
  .search-overlay :global(.pagefind-ui__form::before) {
    top: 1.65rem !important;
    left: 1.75rem !important;
  }
  /* Input uses Pagefind's own width:100% — just restyle */
  .search-overlay :global(.pagefind-ui__search-input) {
    margin: 0;
    padding: 0.75rem 1rem 0.75rem 2.4rem; /* space for Pagefind's search icon */
    border: 1px solid var(--valkey-line, #d9dde2);
    border-radius: 10px;
    font-size: 1rem;
    background: var(--valkey-bg-soft, #f8f9fa);
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    box-sizing: border-box;
    height: auto;
  }
  .search-overlay :global(.pagefind-ui__search-input:focus) {
    outline: 0;
    background: #fff;
    border-color: var(--valkey-blue-300, #0055a6);
    box-shadow: 0 0 0 3px rgba(0, 85, 166, 0.15);
  }
  /* Hide Pagefind's built-in clear button — our × button does this */
  .search-overlay :global(.pagefind-ui__search-clear) {
    display: none !important;
  }
  /* Drawer: the single scroll region */
  .search-overlay :global(.pagefind-ui__drawer) {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    margin: 0 !important; /* Pagefind default: margin: 0 -16px */
    padding: 0 1rem;
    border-top: 1px solid var(--valkey-line, #d9dde2);
    scrollbar-width: thin;
    scrollbar-color: var(--valkey-line, #d9dde2) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .search-overlay :global(.pagefind-ui__drawer::-webkit-scrollbar) {
    width: 10px;
  }
  .search-overlay :global(.pagefind-ui__drawer::-webkit-scrollbar-track) {
    background: transparent;
  }
  .search-overlay :global(.pagefind-ui__drawer::-webkit-scrollbar-thumb) {
    background: var(--valkey-line, #d9dde2);
    border-radius: 5px;
    border: 2px solid #fff;
  }
  .search-overlay :global(.pagefind-ui__drawer::-webkit-scrollbar-thumb:hover) {
    background: var(--valkey-text-light, #647782);
  }
  .search-overlay :global(.pagefind-ui__results-area) {
    padding: 0.5rem 0 0.75rem;
  }
  .search-overlay :global(.pagefind-ui__message) {
    color: var(--valkey-text-light, #647782);
    font-size: 0.85rem;
    padding: 0.5rem 0;
    margin: 0;
    font-family: var(--valkey-sans, "Open Sans", sans-serif);
  }
  .search-overlay :global(.pagefind-ui__result) {
    padding: 0.9rem 0;
    border-top: 1px solid var(--valkey-line, #eaedef);
  }
  .search-overlay :global(.pagefind-ui__result:first-child) {
    border-top: 0;
  }
  .search-overlay :global(.pagefind-ui__result-link) {
    color: var(--valkey-deep-blue, #003b5c);
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.35;
  }
  .search-overlay :global(.pagefind-ui__result-link:hover) {
    color: var(--valkey-blue-300, #0055a6);
    text-decoration: underline;
  }
  .search-overlay :global(.pagefind-ui__result-link[data-vk-selected]) {
    background: rgba(0, 85, 166, 0.08);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    box-shadow: 0 0 0 2px var(--valkey-blue-300, #0055a6);
    outline: none;
    color: var(--valkey-blue-300, #0055a6);
  }
  .search-overlay :global(.pagefind-ui__result-excerpt) {
    font-size: 0.88rem;
    color: var(--valkey-text, #334);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
  .search-overlay :global(mark) {
    background: #ffe9a8;
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
    font-weight: 600;
  }
  /* Tablet: take more of the width */
  @media (max-width: 768px) {
    .search-overlay {
      width: calc(100vw - 1.5rem);
      max-width: calc(100vw - 1.5rem);
      height: min(calc(100dvh - 3rem), 85dvh);
      max-height: calc(100vh - 3rem);
      margin: 1.5rem auto;
    }
  }
  /* Mobile: essentially full-screen */
  @media (max-width: 520px) {
    .search-overlay {
      width: calc(100vw - 0.75rem);
      max-width: calc(100vw - 0.75rem);
      height: calc(100dvh - 1.5rem);
      max-height: calc(100dvh - 1.5rem);
      margin: 0.75rem auto;
      border-radius: 12px;
    }
    .search-overlay :global(.pagefind-ui__form) {
      padding: 0.75rem 2.75rem 0.5rem 0.75rem;
    }
    .search-overlay :global(.pagefind-ui__form::before) {
      top: 1.3rem !important;
      left: 1.5rem !important;
    }
    .search-overlay :global(.pagefind-ui__search-input) {
      font-size: 1rem; /* >= 16px prevents iOS zoom */
      padding: 0.65rem 0.75rem 0.65rem 2.2rem;
    }
    .search-overlay :global(.pagefind-ui__drawer) {
      padding: 0 0.75rem;
    }
    .search-overlay-close {
      top: 8px;
      right: 8px;
    }
    .search-overlay-foot {
      display: none; /* hide keyboard hints on mobile (no keyboard) */
    }
  }
  /* Short viewports (landscape mobile, small laptops) */
  @media (max-height: 520px) {
    .search-overlay {
      height: calc(100dvh - 1rem);
      max-height: calc(100dvh - 1rem);
      margin: 0.5rem auto;
    }
  }
</style>
