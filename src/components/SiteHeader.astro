---
import Search from "@astrojs/starlight/components/Search.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header" data-pagefind-ignore>
  <div class="inner">
    <a href="/" class="logo" aria-label="Valkey home">
      <img src="/img/valkey-horizontal.svg" alt="Valkey" width="130" height="46" />
    </a>

    <button
      class="btn-menu"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="site-nav"
      data-mobile-menu-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <nav role="navigation" aria-label="Main" id="site-nav">
      <a href="/download/" class={isActive("/download/") ? "active" : undefined}>Download</a>

      <div class="has-submenu">
        <a href="/docs/" class={isActive("/docs/") || isActive("/commands/") || isActive("/topics/") || isActive("/clients/") ? "active" : undefined}
          >Documentation ▾</a
        >
        <div class="submenu">
          <a href="/commands/">Command Reference</a>
          <a href="/topics/">Documentation by Topic</a>
          <a href="/clients/">Client Libraries</a>
          <a href="/glide/">Valkey GLIDE</a>
        </div>
      </div>

      <a href="/blog/" class={isActive("/blog/") ? "active" : undefined}>Blog</a>

      <div class="has-submenu">
        <a href="/community/" class={isActive("/community/") || isActive("/events/") ? "active" : undefined}
          >Community ▾</a
        >
        <div class="submenu">
          <a href="/events/">Events</a>
        </div>
      </div>

      <a href="/participants/" class={isActive("/participants/") ? "active" : undefined}>Participants</a>
      <a href="/try-valkey/" class={isActive("/try-valkey/") ? "active" : undefined}>Try Valkey</a>

      <Search class="vk-search" />

      <button
        type="button"
        class="theme-toggle"
        aria-label="Toggle light/dark theme"
        title="Toggle light/dark theme"
        data-theme-toggle
      >
        {/* Sun icon — shown when dark theme is active (click to go light). */}
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        {/* Moon icon — shown in light theme (click to go dark). */}
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="https://github.com/valkey-io" class="github-button" target="_blank" rel="noopener" aria-label="Valkey on GitHub">
        <img src="/img/IconGithub.svg" alt="" width="16" height="16" class="gh-icon" />
        <span class="gh-text">GitHub</span>
        {/* Stars badge: reserves min-width via CSS so it never shifts
            other nav items when the value arrives. The inline script
            below fills it from cache synchronously (before paint). The
            post-load module script refreshes the cache when expired. */}
        <span class="gh-stars" data-github-stars>&nbsp;</span>
      </a>
    </nav>
  </div>

  {/* Synchronous (is:inline, no defer) — fills the GH stars badge from
      localStorage right after the element parses. Runs in the same
      microtask as the parser, so the badge text is in place before the
      browser composites the first frame: no flash, no reflow. */}
  <script is:inline>
    (function () {
      try {
        const raw = localStorage.getItem("valkey:gh:stars");
        if (!raw) return;
        const c = JSON.parse(raw);
        if (!c || typeof c.v !== "number") return;
        const v = c.v;
        const text = (v >= 1000 ? (v / 1000).toFixed(1) + "k" : String(v)) + " ★";
        document.querySelectorAll("[data-github-stars]").forEach(function (el) {
          el.textContent = text;
        });
      } catch (e) {}
    })();
  </script>
</header>

<script>
  // Search trigger + dialog come from Starlight (`<Search />`), which handles
  // ⌘K and Ctrl+K natively, lazy-loads PagefindUI from /pagefind/, and
  // injects translations.

  // Mobile menu toggle
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("mobile-open", !open);
  });

  // Theme toggle. Uses the same `starlight-theme` localStorage key that
  // Starlight's ThemeProvider/ThemeSelect use, so toggling here matches the
  // Starlight setting on docs pages without a second source of truth.
  // The actual <html data-theme="..."> attribute is set by an inline script
  // in MarketingLayout (and Starlight's ThemeProvider on docs pages) before
  // first paint, so this listener only handles user-initiated toggles.
  const STORAGE_KEY = "starlight-theme";
  const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function currentTheme(): "light" | "dark" {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }
  function applyTheme(t: "light" | "dark") {
    document.documentElement.dataset.theme = t;
    try {
      localStorage.setItem(STORAGE_KEY, t);
    } catch {}
    // Keep Starlight's <select> picker (if mounted on docs pages) in sync.
    const w = window as any;
    if (w.StarlightThemeProvider?.updatePickers) {
      try { w.StarlightThemeProvider.updatePickers(t); } catch {}
    }
  }
  // Easter egg: 6 rapid theme toggles (within a 3-second sliding window)
  // unlock "Aurora" — the homepage hero gradient starts to slowly drift
  // through the brand palette. The state lives on <html class="vk-aurora">
  // so HomeHero's CSS rule can pick it up. Pure CSS animation after that;
  // no runtime JS cost. Resets on reload.
  const AURORA_THRESHOLD = 6;
  const AURORA_WINDOW_MS = 3000;
  const auroraToggles: number[] = [];
  themeBtn?.addEventListener("click", () => {
    applyTheme(currentTheme() === "dark" ? "light" : "dark");

    if (document.documentElement.classList.contains("vk-aurora")) return;
    const now = Date.now();
    auroraToggles.push(now);
    // Drop entries outside the sliding window.
    while (auroraToggles.length && now - auroraToggles[0] > AURORA_WINDOW_MS) {
      auroraToggles.shift();
    }
    if (auroraToggles.length >= AURORA_THRESHOLD) {
      document.documentElement.classList.add("vk-aurora");
      auroraToggles.length = 0;
      try {
        // eslint-disable-next-line no-console
        console.log(
          "%c✦ Aurora unlocked.",
          "font: 600 13px/1.4 ui-monospace, monospace; color: #8736aa; padding: 4px 8px; border: 1px solid #b9d9eb; border-radius: 4px;",
        );
      } catch {}
    }
  });

  // GitHub stars for valkey-io/valkey, cached for 1 hour. The cached
  // value is also painted synchronously by the pre-paint script in
  // MarketingLayout, so on repeat visits there's no shift — this only
  // refreshes when the cache expires.
  (async () => {
    const CACHE_KEY = "valkey:gh:stars";
    const CACHE_TTL = 60 * 60 * 1000;
    let cachedAt = 0;
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw) cachedAt = JSON.parse(raw).ts || 0;
    } catch {}
    if (cachedAt && Date.now() - cachedAt < CACHE_TTL) return; // pre-paint handled it
    try {
      const r = await fetch("https://api.github.com/repos/valkey-io/valkey");
      if (!r.ok) return;
      const d = await r.json();
      const stars: number = d.stargazers_count;
      try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), v: stars })); } catch {}
      const formatted = stars >= 1000 ? (stars / 1000).toFixed(1) + "k" : String(stars);
      document.querySelectorAll<HTMLElement>("[data-github-stars]").forEach((el) => {
        el.textContent = `${formatted} ★`;
      });
    } catch {}
  })();
</script>
