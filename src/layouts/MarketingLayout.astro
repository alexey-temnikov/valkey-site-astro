---
import "../styles/valkey-brand.css";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const {
  title,
  description = "Valkey is an open source (BSD) high-performance key/value datastore.",
  bodyClass = "",
} = Astro.props;
const image = "/img/valkey-logo-og.png";

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://127.0.0.1:4322").toString();

// GTM id can be injected at build time via env; falls back to the valkey.io id.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || "GTM-MFFCB7SR";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Pre-paint bootstrap. Runs synchronously in <head> before any CSS
        is applied, so it can decide initial state for theme and the
        announcement banner without flashing or shifting layout. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // 1. Theme — same `starlight-theme` localStorage key Starlight uses
        try {
          const stored = localStorage.getItem("starlight-theme");
          const theme = stored
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          root.dataset.theme = theme === "dark" ? "dark" : "light";
        } catch (e) {
          root.dataset.theme = "light";
        }
        // 2. Announcement banner — if dismissed within the last 24h, mark
        //    <html> so CSS can hide it before paint (no FOUC, no shift).
        try {
          const closedAt = Number(localStorage.getItem("valkey:banner:closedAt") || 0);
          if (closedAt && Date.now() - closedAt < 24 * 60 * 60 * 1000) {
            root.classList.add("banner-dismissed");
          }
        } catch {}
      })();
    </script>

    {/* Crawler / legacy-browser hints, ported verbatim from Zola head.html */}
    <meta name="ROBOTS" content="ALL" />
    <meta name="MSSmartTagsPreventParsing" content="true" />
    <meta name="Copyright" content="" />
    <meta name="keywords" content="open-source, valkey" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicon suite — full set from public/img/favicon/, mirrors Zola */}
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/img/favicon/site.webmanifest" />
    <link rel="mask-icon" href="/img/favicon/safari-pinned-tab.svg" color="#5bbad5" />
    <link rel="shortcut icon" href="/img/favicon/favicon.ico" />
    <meta name="msapplication-TileColor" content="#2d89ef" />
    <meta name="msapplication-TileImage" content="/img/favicon/mstile-144x144.png" />
    <meta name="msapplication-config" content="/img/favicon/browserconfig.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1217" media="(prefers-color-scheme: dark)" />

    {/* Preload the webfonts that render above the fold so font swap
        doesn't cause layout shifts after first paint. Open Sans 400
        powers body text; the Condensed 700 powers the hero headlines
        and uppercase eyebrows that are visible on every page. */}
    <link rel="preload" href="/fonts/open-sans/opensans-latin-normal-400-v20.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/opensans-latin-normal-600-v20.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/opensans-latin-normal-700-v20.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans-condensed/opensanscondensed-latin-normal-700-v15.woff2" as="font" type="font/woff2" crossorigin />

    {/* Open Graph + Twitter */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, Astro.site ?? "http://127.0.0.1:4322").toString()} />
    <meta property="og:site_name" content="Valkey" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@valkey_io" />

    {/* Feed discovery: site-wide Atom feed + blog RSS + sitemap */}
    <link rel="alternate" type="application/atom+xml" title="Valkey Atom feed" href="/atom.xml" />
    <link rel="alternate" type="application/rss+xml" title="Valkey Blog" href="/blog/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* Osano cookie consent */}
    {import.meta.env.PROD && (
      <script is:inline src="https://cmp.osano.com/16A0DbT9yDNIaQkvZ/31b1b91a-e0b6-47ea-bde2-7f2bd13dbe5c/osano.js?variant=one"></script>
    )}

    {/* Google Tag Manager (async, consent-aware) */}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ GTM_ID }}>{`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s);j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', GTM_ID);
      `}</script>
    )}
  </head>
  <body class={bodyClass}>
    {/* Scarf analytics pixel */}
    {import.meta.env.PROD && (
      <img referrerpolicy="no-referrer-when-downgrade" src="https://static.scarf.sh/a.png?x-pxid=4682283c-f8b7-410c-9c31-c6d7944cee8b" alt="" width="0" height="0" style="position:absolute;left:-9999px" />
    )}

    {/* GTM noscript fallback */}
    {import.meta.env.PROD && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}

    <SiteHeader />
    <main data-pagefind-body>
      {/* Announcement banner sits BELOW the header so the logo's
          position matches Starlight docs pages, where the fixed header
          is at top:0 and the banner renders inside the main content
          area (PageFrame.astro). Without this, the banner pushes the
          logo down by its own height (which varies with viewport),
          breaking parity with the docs page. */}
      <AnnouncementBanner />
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
