---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";

// Fetch events and sort descending by date. The `date` field has already been
// normalized to a local-noon Date by the zod transform in content.config.ts,
// so no further TZ conversion is needed here.
const entries = await getCollection("events");

// Serializable shape for the inline <script> — Date objects round-trip as
// strings through define:vars, so we pre-format YYYY-MM-DD here.
const events = entries
  .map((p) => {
    const d = p.data.date as Date;
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    const isoDate = `${y}-${m}-${day}`;
    return {
      slug: p.id,
      title: p.data.title as string,
      date: isoDate,
      type: (p.data.event_type as string) || "first-party",
      location: (p.data.location as string) || "",
      locationUrl: (p.data.location_url as string) || "",
      url: (p.data.external_url as string) || `/events/${p.id}/`,
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date));
---

<MarketingLayout title="Valkey · Events" description="Valkey community events and conferences">
  <div class="page-subhead">
    <h1 class="page-title">Events</h1>
  </div>

  <div class="events-calendar">
    <div class="events-legend">
      <span class="legend-item"><span class="legend-dot first-party"></span> Valkey Events</span>
      <span class="legend-item"><span class="legend-dot third-party"></span> Third Party</span>
    </div>

    <div class="calendar-nav">
      <button class="calendar-nav-btn" id="cal-prev" aria-label="Previous month">&#9664;</button>
      <span class="calendar-nav-title" id="cal-title"></span>
      <button class="calendar-nav-btn" id="cal-next" aria-label="Next month">&#9654;</button>
    </div>

    <div class="calendar-grid" id="cal-grid">
      <div class="calendar-header">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div class="calendar-days" id="cal-days"></div>
    </div>

    <div class="events-list" id="events-list"></div>
  </div>

  <script is:inline define:vars={{ events }}>
    document.addEventListener("DOMContentLoaded", function () {
      if (!events || events.length === 0) return;

      // Collect events by month ("YYYY-MM" → [event]).
      var monthSet = {};
      events.forEach(function (e) {
        var key = e.date.substring(0, 7);
        if (!monthSet[key]) monthSet[key] = [];
        monthSet[key].push(e);
      });

      // Build the full range of months from the earliest to the latest event
      // so the prev/next buttons step across a contiguous timeline.
      var eventDates = events.map(function (e) { return e.date; }).sort();
      var first = eventDates[0].split("-");
      var last = eventDates[eventDates.length - 1].split("-");
      var months = [];
      var y = Number(first[0]), m = Number(first[1]);
      var endY = Number(last[0]), endM = Number(last[1]);
      while (y < endY || (y === endY && m <= endM)) {
        months.push(y + "-" + (m < 10 ? "0" + m : m));
        m++;
        if (m > 12) { m = 1; y++; }
      }
      var currentIdx = 0;

      // Start on the current month if it falls inside the range.
      var now = new Date();
      var currentKey = now.getFullYear() + "-" + (now.getMonth() + 1 < 10 ? "0" + (now.getMonth() + 1) : "" + (now.getMonth() + 1));
      var foundIdx = months.indexOf(currentKey);
      if (foundIdx !== -1) currentIdx = foundIdx;

      var monthNames = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December",
      ];

      function daysInMonth(yr, mo) { return new Date(yr, mo + 1, 0).getDate(); }
      // Convert JS Sun=0..Sat=6 to Mon=0..Sun=6 so the grid starts on Monday.
      function startDay(yr, mo) { var d = new Date(yr, mo, 1).getDay(); return d === 0 ? 6 : d - 1; }

      function render() {
        var key = months[currentIdx];
        var parts = key.split("-");
        var year = Number(parts[0]);
        var month = Number(parts[1]) - 1;
        var total = daysInMonth(year, month);
        var start = startDay(year, month);
        var evts = monthSet[key] || [];

        var byDay = {};
        evts.forEach(function (e) {
          var d = Number(e.date.substring(8, 10));
          if (!byDay[d]) byDay[d] = [];
          byDay[d].push(e);
        });

        document.getElementById("cal-title").textContent = monthNames[month] + " " + year;

        var html = "";
        for (var i = 0; i < start; i++) html += '<div class="calendar-day empty"></div>';
        for (var d = 1; d <= total; d++) {
          var hasEvents = byDay[d];
          if (hasEvents) {
            var labels = "";
            hasEvents.forEach(function (e) {
              labels += '<a href="' + e.url + '" class="event-label ' + e.type + '">' + e.title + "</a>";
            });
            html += '<div class="calendar-day has-event"><span class="day-num">' + d + "</span>" + labels + "</div>";
          } else {
            html += '<div class="calendar-day"><span class="day-num">' + d + '</span></div>';
          }
        }
        document.getElementById("cal-days").innerHTML = html;

        // Highlight the current month's event cards in the list below.
        var allCards = document.querySelectorAll(".event-card");
        var firstMatch = null;
        allCards.forEach(function (card) {
          var cardMonth = card.getAttribute("data-month");
          if (cardMonth === key) {
            card.classList.add("active");
            if (!firstMatch) firstMatch = card;
          } else {
            card.classList.remove("active");
          }
        });
        if (firstMatch) firstMatch.scrollIntoView({ behavior: "smooth", block: "nearest" });

        document.getElementById("cal-prev").disabled = currentIdx === 0;
        document.getElementById("cal-next").disabled = currentIdx === months.length - 1;
      }

      // Render all event cards (sorted descending by date).
      var allEvents = events.slice().sort(function (a, b) { return b.date.localeCompare(a.date); });
      var today = new Date().toISOString().substring(0, 10);
      var upcomingEvents = allEvents.filter(function (e) { return e.date >= today; });
      var pastEvents = allEvents.filter(function (e) { return e.date < today; });

      var listHtml = "";

      // Upcoming events
      if (upcomingEvents.length > 0) {
        upcomingEvents.forEach(function (e) {
          var parts = e.date.split("-");
          var dateObj = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]), 12, 0, 0);
          var dateStr = monthNames[dateObj.getMonth()] + " " + dateObj.getDate() + ", " + dateObj.getFullYear();
          var eventMonth = e.date.substring(0, 7);
          listHtml +=
            '<div class="event-card" data-month="' + eventMonth + '">' +
            '<span class="event-card-badge ' + e.type + '">' + (e.type === "first-party" ? "Valkey Event" : "Third Party") + "</span>" +
            '<h3><a href="' + e.url + '">' + e.title + "</a></h3>" +
            '<p class="event-card-date">' + dateStr + "</p>" +
            (e.location ? '<p class="event-card-location"><a href="' + e.locationUrl + '" target="_blank" rel="noopener">' + e.location + "</a></p>" : "") +
            "</div>";
        });
      } else {
        listHtml += '<p class="no-events">No upcoming events. Check back soon!</p>';
      }

      // Past events (collapsed by default)
      if (pastEvents.length > 0) {
        listHtml += '<details class="past-events-toggle"><summary>Past events (' + pastEvents.length + ')</summary><div class="past-events-list">';
        pastEvents.forEach(function (e) {
          var parts = e.date.split("-");
          var dateObj = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]), 12, 0, 0);
          var dateStr = monthNames[dateObj.getMonth()] + " " + dateObj.getDate() + ", " + dateObj.getFullYear();
          var eventMonth = e.date.substring(0, 7);
          listHtml +=
            '<div class="event-card past" data-month="' + eventMonth + '">' +
            '<span class="event-card-badge ' + e.type + '">' + (e.type === "first-party" ? "Valkey Event" : "Third Party") + "</span>" +
            '<h3><a href="' + e.url + '">' + e.title + "</a></h3>" +
            '<p class="event-card-date">' + dateStr + "</p>" +
            (e.location ? '<p class="event-card-location"><a href="' + e.locationUrl + '" target="_blank" rel="noopener">' + e.location + "</a></p>" : "") +
            "</div>";
        });
        listHtml += '</div></details>';
      }

      document.getElementById("events-list").innerHTML = listHtml;

      document.getElementById("cal-prev").addEventListener("click", function () { if (currentIdx > 0) { currentIdx--; render(); } });
      document.getElementById("cal-next").addEventListener("click", function () { if (currentIdx < months.length - 1) { currentIdx++; render(); } });

      render();
    });
  </script>
</MarketingLayout>

<style is:global>
  /* Events calendar + list — port from sass/_valkey.scss. */
  .events-calendar {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 20px;
  }

  .events-legend {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-bottom: 2rem;
    font-size: 1.4rem;
  }
  .events-legend .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .events-legend .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .events-legend .legend-dot.first-party { background-color: #6983ff; }
  .events-legend .legend-dot.third-party { background-color: #CC9316; }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .calendar-nav .calendar-nav-title {
    font-size: 2.2rem;
    font-weight: 600;
    min-width: 220px;
    text-align: center;
    color: var(--valkey-text);
  }
  .calendar-nav .calendar-nav-btn {
    background: none;
    border: 1px solid var(--valkey-line);
    border-radius: 4px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 1.6rem;
    color: var(--valkey-text);
  }
  .calendar-nav .calendar-nav-btn:hover:not(:disabled) { background-color: var(--valkey-bg-soft); }
  .calendar-nav .calendar-nav-btn:disabled { opacity: 0.3; cursor: default; }

  .calendar-grid {
    border: 1px solid var(--valkey-line);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .calendar-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    background-color: var(--valkey-deep-blue);
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 600;
    text-align: center;
  }
  .calendar-header span { padding: 0.8rem 0; }

  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }

  .calendar-day {
    min-height: 60px;
    padding: 0.4rem;
    border: 1px solid var(--valkey-line-soft);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    font-size: 1.3rem;
    min-width: 0;
    overflow: hidden;
  }
  .calendar-day.empty { background-color: var(--valkey-bg-soft); }
  .calendar-day.has-event { background-color: color-mix(in srgb, var(--valkey-blue-300) 5%, transparent); }
  .calendar-day .day-num {
    color: var(--valkey-text-light);
    margin-bottom: 0.3rem;
  }

  .event-label {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 1rem;
    line-height: 1.2;
    color: #ffffff;
    text-decoration: none;
    word-break: break-word;
    margin-top: 2px;
  }
  .event-label.first-party { background-color: #6983ff; }
  .event-label.third-party { background-color: #CC9316; }
  .event-label:hover { opacity: 0.85; }
  .event-label, .event-label:visited { color: #ffffff; }

  .events-list {
    display: grid;
    gap: 1.5rem;
    max-height: 400px;
    overflow-y: auto;
    padding: 0.5rem;
  }
  .events-list .event-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--valkey-line);
    border-radius: 8px;
    background: var(--valkey-bg-elevated);
    transition: box-shadow 0.2s, border-color 0.2s, background 0.2s;
  }
  .events-list .event-card:hover { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }
  .events-list .event-card.active { border-color: #00a3e0; box-shadow: 0 0 0 2px #00a3e0; }
  .events-list .event-card.past { opacity: 0.5; }

  .events-list .event-card h3 {
    margin: 0.5rem 0;
    font-size: 1.8rem;
  }
  .events-list .event-card h3 a { color: var(--valkey-text); text-decoration: none; }
  .events-list .event-card h3 a:hover { color: var(--valkey-link); }

  .events-list .event-card-badge {
    display: inline-block;
    padding: 0.2rem 0.8rem;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
  }
  .events-list .event-card-badge.first-party { background-color: #6983ff; }
  .events-list .event-card-badge.third-party { background-color: #CC9316; }

  .events-list .event-card-date {
    font-size: 1.4rem;
    color: var(--valkey-text-light);
    margin: 0.3rem 0;
  }
  .events-list .event-card-location {
    font-size: 1.4rem;
    margin: 0.3rem 0;
  }
  .events-list .event-card-location a { color: var(--valkey-link); }

  .events-list .no-events {
    text-align: center;
    color: var(--valkey-text-light);
    font-size: 1.4rem;
    padding: 2rem 0;
  }

  .events-list .past-events-toggle {
    border-top: 1px solid var(--valkey-line);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }
  .events-list .past-events-toggle summary {
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--valkey-text-light);
    padding: 0.5rem 0;
  }
  .events-list .past-events-toggle summary:hover {
    color: var(--valkey-text);
  }
  .events-list .past-events-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (max-width: 600px) {
    .calendar-header span { font-size: 1.1rem; }
    .calendar-day { min-height: 40px; font-size: 1.1rem; }
    .calendar-nav .calendar-nav-title { font-size: 1.8rem; min-width: auto; }
  }
</style>
