---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("events");
const events = entries
  .map((p) => {
    const slug = p.id;
    return { slug, ...(p.data as any) };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(d: string) {
  return new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}
---

<MarketingLayout title="Events · Valkey" description="Valkey community events and conferences">
  <section class="events-page width-limiter">
    <h1>Events</h1>
    <p class="lead">Conferences, meetups, and community gatherings for the Valkey ecosystem.</p>

    <div class="events-legend">
      <span class="legend-item"><span class="legend-dot first-party"></span> Valkey Events</span>
      <span class="legend-item"><span class="legend-dot third-party"></span> Third Party</span>
    </div>

    <div class="events-list">
      {events.map((ev) => (
        <article class={`event-card ${ev.event_type ?? "first-party"}`}>
          <span class={`event-badge ${ev.event_type ?? "first-party"}`}>
            {ev.event_type === "third-party" ? "Third Party" : "Valkey Event"}
          </span>
          <h2><a href={`/events/${ev.slug}/`}>{ev.title}</a></h2>
          <p class="meta">{formatDate(ev.date)}</p>
          {ev.location && (
            <p class="location">
              <a href={ev.location_url} target="_blank" rel="noopener">{ev.location}</a>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .events-page { padding: 3rem 1.5rem 5rem; }
  .events-page h1 { font-family: var(--valkey-cond); font-size: clamp(2.25rem, 4vw, 3.5rem); margin: 0 0 0.5rem; }
  .lead { color: var(--valkey-text-light); font-size: 1.05rem; margin: 0 0 2rem; }
  .events-legend { display: flex; gap: 1.5rem; margin-bottom: 2rem; }
  .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--valkey-text-light); }
  .legend-dot { width: 12px; height: 12px; border-radius: 50%; }
  .legend-dot.first-party { background: var(--valkey-blue-300); }
  .legend-dot.third-party { background: var(--valkey-purple-300); }
  .events-list { display: grid; gap: 1.5rem; }
  .event-card { border: 1px solid var(--valkey-line); border-radius: 10px; padding: 1.5rem; background: #fff; transition: box-shadow 0.15s ease, border-color 0.15s ease; }
  .event-card:hover { border-color: var(--valkey-blue-100); box-shadow: 0 4px 16px rgba(0, 85, 166, 0.08); }
  .event-badge { display: inline-block; font-size: 0.7rem; padding: 0.15rem 0.55rem; border-radius: 999px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; }
  .event-badge.first-party { background: var(--valkey-blue-300); }
  .event-badge.third-party { background: var(--valkey-purple-300); }
  .event-card h2 { margin: 0.5rem 0 0.5rem; font-size: 1.3rem; }
  .event-card h2 a { color: var(--valkey-text); }
  .event-card h2 a:hover { color: var(--valkey-blue-300); text-decoration: none; }
  .meta { color: var(--valkey-text-light); font-size: 0.9rem; margin: 0 0 0.25rem; }
  .location { font-size: 0.9rem; }
  .location a { color: var(--valkey-blue-300); }
</style>
