---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("events");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// `external_url` events redirect to a third-party site — render a minimal meta-refresh
// page and no body content. Mirrors templates/event-page.html:3-6 in the Zola reference.
const externalUrl = entry.data.external_url as string | undefined;

// Convert the optional footer_add markdown snippet to HTML. Reference stores short
// one-line credits like "Header image: [Horsehead Nebula](https://...). License: [CC BY 4.0](https://...)",
// so a tiny inline converter is sufficient — no block-level elements needed.
function renderInlineMarkdown(src: string | undefined): string {
  if (!src) return "";
  const escaped = src
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  // [text](url) → <a>
  return escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, text, url) => {
    const safeUrl = url.replace(/"/g, "&quot;");
    return `<a href="${safeUrl}" target="_blank" rel="noopener">${text}</a>`;
  });
}
const footerAddHtml = renderInlineMarkdown(entry.data.footer_add);
---

{externalUrl ? (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="refresh" content={`0; url=${externalUrl}`} />
      <title>{`Valkey · ${entry.data.title}`}</title>
      <link rel="canonical" href={externalUrl} />
      <meta name="robots" content="noindex" />
    </head>
    <body>
      <p>
        Redirecting to <a href={externalUrl}>{externalUrl}</a>…
      </p>
    </body>
  </html>
) : (
  <MarketingLayout
    title={`Valkey · ${entry.data.title}`}
    description={entry.data.title}
    bodyClass={entry.data.body_class ?? ""}
  >
    <div class="styled-title event-title">
      <h1>
        {entry.data.event_logo ? (
          <img src={entry.data.event_logo} alt={entry.data.title} />
        ) : (
          entry.data.title
        )}
      </h1>
    </div>

    <div class="event-single">
      <article>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/events/">Events</a> <span class="sep">›</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>

        <div class="prose">
          <Content />
        </div>

        {footerAddHtml && (
          <p class="footer-add" set:html={footerAddHtml} />
        )}

        <footer class="post-footer">
          <a href="/events/" class="back">← Back to events</a>
        </footer>
      </article>
    </div>
  </MarketingLayout>
)}

<style is:global>
  /* Event page — image-variant banner plus event-single layout. */
  .styled-title.event-title img {
    width: 33%;
    max-width: 500px;
    height: auto;
  }

  .event-single {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }
  .event-single main {
    flex: 1;
    padding: 2rem;
    width: 100%;
  }

  .event-single .prose iframe { max-width: 100%; border-radius: 8px; margin: 1rem 0; }

  .event-single .footer-add {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dotted var(--valkey-line);
    font-size: 0.85rem;
    color: var(--valkey-text-light);
  }
  .event-single .footer-add a { color: var(--valkey-link); }

  /* body_class = "keyspace-2025" — nebula hero background + dark theme.
     Image path uses /events/keyspace-2025/... to match the reference URL. */
  body.keyspace-2025 .styled-title {
    background-image: url("/events/keyspace-2025/keyspace-nebula-new.jpg");
    background-size: cover;
    background-position: center;
  }
  body.keyspace-2025 {
    background-color: #000;
  }
  body.keyspace-2025 .event-single main {
    color: #fff;
  }
  body.keyspace-2025 .event-single .prose a,
  body.keyspace-2025 .event-single .breadcrumbs a,
  body.keyspace-2025 .event-single .post-footer .back,
  body.keyspace-2025 .event-single .footer-add a {
    color: #8fd0ff;
  }
  body.keyspace-2025 .event-single .breadcrumbs .sep {
    color: rgba(255, 255, 255, 0.35);
  }
  body.keyspace-2025 .event-single .prose h2,
  body.keyspace-2025 .event-single .prose h3 {
    color: #fff;
  }
  body.keyspace-2025 .event-single th {
    background-color: inherit;
  }
  body.keyspace-2025 .event-single tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.1);
  }
  body.keyspace-2025 .event-single td {
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  body.keyspace-2025 .event-single .post-footer {
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  body.keyspace-2025 .event-single .footer-add {
    border-top-color: rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.7);
  }
</style>
