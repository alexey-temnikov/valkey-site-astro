---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ReleaseCard from "../../../components/ReleaseCard.astro";
import { parseReleases, slug, formatDate, type Release } from "../../../lib/releases";

export async function getStaticPaths() {
  const modules = import.meta.glob("/src/content/releases/*.md", { eager: true }) as Record<
    string,
    { frontmatter: Record<string, any> }
  >;
  const releases = parseReleases(modules);
  return releases.map((release) => ({
    params: { version: slug(release) },
    props: { release },
  }));
}

interface Props {
  release: Release;
}

const { release } = Astro.props;
---

<MarketingLayout title={`Download Valkey ${release.tag} · Valkey`}>
  <PageHeader
    title={`Download Valkey ${release.tag}`}
    subtitle={`Released ${formatDate(release.date)}`}
  />

  <section class="width-limiter release-page">
    <p class="release-page-lead">
      <a href="/download/">← Download Latest</a> ·{" "}
      <a href="/download/releases/">All Releases</a>
    </p>

    <ReleaseCard release={release} heading="none" />
  </section>
</MarketingLayout>

<style>
  .release-page {
    padding: 2rem 1.5rem 4rem;
  }
  .release-page-lead {
    color: var(--valkey-text-light);
    margin: 0 0 1.5rem;
  }
</style>
