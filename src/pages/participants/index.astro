---
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
import { marked } from "marked";
import MarketingLayout from "../../layouts/MarketingLayout.astro";

type Participant = {
  name: string;
  link: string;
  image?: { path: string; alt?: string };
  company?: string;
  offering?: string;
};

const intro = fs.readFileSync(
  path.resolve("src/content/pages/participants.md"),
  "utf8",
);
const introBody = intro.replace(/^---[\s\S]*?---\s*/, "");
const introHtml = marked.parse(introBody, { async: false }) as string;

const participants = yaml.load(
  fs.readFileSync(path.resolve("src/data/participants.yml"), "utf8"),
) as Participant[];

participants.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));

const newParticipantUrl =
  "https://github.com/valkey-io/valkey-io.github.io/issues/new?assignees=&labels=participant%2C+untriaged&projects=&template=add_participant_form_template.md&title=%5BPARTICIPANT%5D";
---

<MarketingLayout
  title="Participants · Valkey"
  description="Organizations contributing to and supporting the Valkey project."
>
  <section class="participants-page width-limiter">
    <div class="subhead" set:html={introHtml} />

    <div class="participants-container">
      <div id="participants-buttons">
        <a
          class="new-participants"
          href={newParticipantUrl}
          target="_blank"
          rel="noopener"
          title="become a new participant"
          aria-label="Become a new participant"></a>
      </div>
    </div>

    <div class="participant-list">
      {participants.map((p) => (
        <div class={`participant-${p.name.toLowerCase()}`}>
          <a href={p.link} class="participant-brand" target="_blank" rel="noopener">
            {p.image && <img src={p.image.path} alt={p.image.alt ?? `${p.name} logo`} loading="lazy" />}
          </a>
          <div class="participant-info">
            {p.offering && (
              <>
                <h3>Valkey offering:</h3>
                <div set:html={marked.parse(p.offering, { async: false })} />
              </>
            )}
            <h3>About the organization:</h3>
            {p.company && <div set:html={marked.parse(p.company, { async: false })} />}
          </div>
        </div>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .participants-page {
    padding: 3rem 1.5rem 5rem;
  }
  .subhead :global(h1) {
    color: var(--valkey-text-strong);
    margin: 0 0 1rem;
  }
  .subhead :global(p) {
    color: var(--valkey-text-light);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 60rem;
    margin: 0 0 1.5rem;
  }

  .participants-container {
    margin: 1.5rem 0 2.5rem;
  }
  #participants-buttons {
    display: flex;
    gap: 1rem;
  }
  .new-participants {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--valkey-line);
    border-radius: 999px;
    color: var(--valkey-text-strong);
    text-decoration: none;
    font-family: var(--valkey-cond);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .new-participants::after {
    content: "Become a new participant";
  }
  .new-participants:hover {
    background: var(--valkey-text-strong);
    color: var(--valkey-bg);
  }

  .participant-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .participant-list > div {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    align-items: start;
    border-top: 1px solid var(--valkey-line);
    padding-top: 2rem;
  }
  .participant-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: var(--valkey-bg-soft);
    border: 1px solid var(--valkey-line-soft);
    min-height: 96px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .participant-brand img {
    max-width: 180px;
    max-height: 80px;
    width: auto;
    object-fit: contain;
  }
  /* Most vendor logos are dark-text on transparent. In dark mode the page
     background is near-black, so we paint the brand card white-ish to keep
     the original logos readable without per-logo CSS hacks. */
  :global(html[data-theme="dark"]) .participant-brand {
    background: #ffffff;
    border-color: rgba(255, 255, 255, 0.12);
  }
  :global(html[data-theme="dark"]) .participant-brand:hover {
    background: #f5f7f7;
  }
  .participant-info :global(h3) {
    font-family: var(--valkey-cond);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--valkey-text-strong);
    margin: 1rem 0 0.5rem;
    font-size: 1.05rem;
  }
  .participant-info :global(h3:first-child) {
    margin-top: 0;
  }
  .participant-info :global(p) {
    color: var(--valkey-text-light);
    line-height: 1.6;
    margin: 0.5rem 0;
  }
  .participant-info :global(a) {
    color: var(--valkey-link, #6983ff);
  }

  @media (max-width: 640px) {
    .participant-list > div {
      grid-template-columns: 1fr;
    }
    .participant-brand {
      justify-content: flex-start;
    }
  }
</style>
