---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { marked } from "marked";
import participants from "../../data/participants.json";
---

<MarketingLayout
  title="Participants · Valkey"
  description="Organizations contributing to and supporting the Valkey project."
>
  <section class="participants-page width-limiter">
    <header>
      <h1 class="page-h1">Participants</h1>
      <p class="lead">
        Valkey is supported by a diverse community of organizations
        contributing code, expertise, managed services, and infrastructure.
      </p>
    </header>

    <div class="logo-wall">
      {participants.map((p: any) => (
        <a href={p.link} target="_blank" rel="noopener" class="logo-link" title={p.name}>
          <img src={p.image.path} alt={p.image.alt} loading="lazy" />
        </a>
      ))}
    </div>

    <div class="profiles">
      {participants.map((p: any) => (
        <article class="profile">
          <div class="profile-header">
            <a href={p.link} target="_blank" rel="noopener">
              <img src={p.image.path} alt={p.image.alt} />
            </a>
            <div>
              <h2>
                <a href={p.link} target="_blank" rel="noopener">{p.name}</a>
              </h2>
            </div>
          </div>
          {p.offering && (
            <>
              <h3>Valkey offering:</h3>
              <div class="offering" set:html={marked.parse(p.offering, { async: false })} />
            </>
          )}
          {p.company && (
            <>
              <h3>About the organization:</h3>
              <div class="company" set:html={marked.parse(p.company, { async: false })} />
            </>
          )}
        </article>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .participants-page {
    padding: 3rem 1.5rem 5rem;
  }
  .lead {
    color: var(--valkey-text-light);
    font-size: 1.1rem;
    max-width: 52rem;
    margin: 0 0 3rem;
  }
  .logo-wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem 2rem;
    margin-bottom: 4rem;
    padding: 2rem;
    background: var(--valkey-bg-soft);
    border-radius: 12px;
    align-items: center;
    justify-items: center;
  }
  .logo-link img {
    max-height: 60px;
    max-width: 160px;
    width: auto;
    object-fit: contain;
    filter: grayscale(30%);
    transition: filter 0.2s ease;
  }
  .logo-link:hover img {
    filter: grayscale(0);
  }
  .profiles {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .profile {
    border-top: 1px solid var(--valkey-line);
    padding-top: 2rem;
  }
  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .profile-header img {
    max-width: 140px;
    max-height: 60px;
    object-fit: contain;
  }
  .profile h2 {
    margin: 0;
    color: var(--valkey-text);
  }
  .profile h2 a {
    color: inherit;
  }
  .profile h3 {
    font-family: var(--valkey-cond);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--valkey-deep-blue);
    margin: 1rem 0 0.5rem;
    font-size: 1.05rem;
  }
  .company,
  .offering {
    color: var(--valkey-text-light);
    line-height: 1.6;
    margin: 0.5rem 0;
  }
</style>
