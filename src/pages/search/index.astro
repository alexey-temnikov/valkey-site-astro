---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
---

<MarketingLayout title="Search · Valkey">
  <section class="width-limiter" style="padding: 4rem 1.5rem;">
    <h1>Search</h1>
    <div id="pagefind-ui" style="max-width: 48rem;"></div>
  </section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof PagefindUI !== "undefined") {
        new PagefindUI({
          element: "#pagefind-ui",
          resetStyles: false,
          showSubResults: true,
        });
        const input = document.querySelector("#pagefind-ui input");
        if (input) (input as HTMLInputElement).focus();
      } else {
        document.getElementById("pagefind-ui")!.innerHTML =
          '<p>Search index not built yet. Run <code>pnpm build</code>, then <code>pnpm preview</code>.</p>';
      }
    });
  </script>
</MarketingLayout>
