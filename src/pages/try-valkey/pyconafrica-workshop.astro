---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import TryValkeyEmulator from "../../components/TryValkeyEmulator.astro";
---

<MarketingLayout
  title="Try Valkey for PyCon Africa 2025 · Valkey"
  description="In-browser Valkey server, valkey-cli, and Python — workshop image for PyCon Africa 2025, powered by a WebAssembly x86 emulator."
>
  <section class="try-valkey width-limiter">
    <header class="try-valkey__intro">
      <h1 class="page-h1">Try Valkey for PyCon Africa 2025</h1>
      <p>
        This is an in-browser Valkey server, <code>valkey-cli</code>, and Python,
        that runs directly within your browser using a
        <a href="https://github.com/copy/v86" target="_blank" rel="noopener">V86</a>
        emulator, requiring no external installations. You will use this to
        complete the workshop.
      </p>
      <p>Try it out below:</p>
    </header>

    <TryValkeyEmulator
      stateFile="https://download.valkey.io/try-me-valkey/pyconafrica/states/tmux-cli-activated.bin.gz"
      filesystemBaseUrl="https://download.valkey.io/try-me-valkey/pyconafrica/fs/alpine-rootfs-flat"
      filesystemBaseFs="https://download.valkey.io/try-me-valkey/pyconafrica/fs/alpine-fs.json"
      cacheKey="valkey_pyconafrica_binary_cache"
      lastModifiedKey="valkey_pyconafrica_last_modified"
    />
  </section>
</MarketingLayout>

<style>
  .try-valkey {
    padding: 3rem 1.5rem 5rem;
  }
  .try-valkey__intro p {
    color: var(--valkey-text-light);
    max-width: 52rem;
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .try-valkey__intro p + p {
    margin-bottom: 2rem;
  }
</style>
