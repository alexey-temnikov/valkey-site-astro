---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import TryValkeyEmulator from "../../components/TryValkeyEmulator.astro";
---

<MarketingLayout
  title="Try Valkey · Valkey"
  description="In-browser Valkey server and CLI powered by a WebAssembly x86 emulator — no install required."
>
  <section class="try-valkey width-limiter">
    <header class="try-valkey__intro">
      <h1 class="page-h1">Try Valkey</h1>
      <p>
        This is an in-browser Valkey server and CLI that runs directly within
        your browser using a <a href="https://github.com/copy/v86" target="_blank" rel="noopener">V86</a>
        emulator, requiring no external installations.
      </p>
      <p>Try it out below:</p>
    </header>

    <TryValkeyEmulator
      stateFile="https://download.valkey.io/try-me-valkey/9.0.4/states/state.bin.gz"
      filesystemBaseUrl="https://download.valkey.io/try-me-valkey/9.0.4/fs/alpine-rootfs-flat"
      filesystemBaseFs="https://download.valkey.io/try-me-valkey/9.0.4/fs/alpine-fs.json"
      cacheKey="valkey_binary_cache"
      lastModifiedKey="valkey_last_modified"
    />
  </section>
</MarketingLayout>

<style>
  /* Layout chrome — kept minimal so the external valkey-try-me.css
     stylesheet (loaded by the TryValkeyEmulator component) can drive the
     emulator's own appearance. */
  .try-valkey {
    padding: 3rem 1.5rem 5rem;
  }
  .try-valkey__intro p {
    color: var(--valkey-text-light);
    max-width: 52rem;
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .try-valkey__intro p + p {
    margin-bottom: 2rem;
  }
</style>
