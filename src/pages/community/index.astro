---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";
import { communityCards } from "../../data/community";

const entries = await getCollection("community");
const sorted = entries
  .filter((p) => !p.id.endsWith("/_index") && p.id !== "_index")
  .sort((a, b) => String(a.data.title ?? a.id).localeCompare(String(b.data.title ?? b.id)));
---

<MarketingLayout title="Community · Valkey" description="Join the Valkey community">
  <section class="community-page width-limiter">
    <h1 class="page-h1">Community</h1>
    <p class="lead">How to Contribute with us?</p>
    <p>We welcome your involvement in the Valkey community! Here are several ways you can contribute:</p>

    <div class="community-card-grid">
      {communityCards.map((card) => (
        <div class="community-card">
          <img src={`/img/${card.icon}`} alt={card.title} class="community-card-icon" />
          <h3>{card.title}</h3>
          <p>{card.description}</p>
          <div class="community-card-actions">
            {card.links.map((link) => (
              <a href={link.url} class="btn" target="_blank" rel="noopener">{link.text}</a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h2 class="section-heading">Community Pages</h2>
    <div class="post-grid">
      {sorted.map((page) => {
        const slug = page.id;
        const data = page.data as any;
        return (
          <article class="post-card">
            <h3><a href={`/community/${slug}/`}>{data.title ?? slug}</a></h3>
            {data.description && <p class="excerpt">{data.description}</p>}
          </article>
        );
      })}
    </div>
  </section>
</MarketingLayout>

<style>
  .community-page { padding: 3rem 1.5rem 5rem; }
  .lead { color: var(--valkey-text-light); font-size: 1.125rem; margin: 0 0 0.5rem; }
  .community-card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0 3rem; }
  .community-card { border: 1px solid var(--valkey-line); border-radius: 10px; padding: 1.5rem; background: var(--valkey-bg-elevated); }
  .community-card-icon { width: 40px; height: 40px; margin-bottom: 0.75rem; }
  .community-card h3 { margin: 0 0 0.5rem; font-size: 1.1rem; color: var(--valkey-text-strong); }
  .community-card p { color: var(--valkey-text-light); font-size: 0.9rem; line-height: 1.5; }
  .community-card-actions { margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--valkey-blue-300); color: var(--valkey-on-accent); padding: 0.4rem 0.9rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; }
  .section-heading { font-family: var(--valkey-cond); text-transform: uppercase; letter-spacing: 0.02em; color: var(--valkey-text-strong); margin: 2.5rem 0 1.5rem; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .post-card { border: 1px solid var(--valkey-line); border-radius: 10px; padding: 1.5rem; background: var(--valkey-bg-elevated); transition: box-shadow 0.15s ease, border-color 0.15s ease; }
  .post-card:hover { border-color: var(--valkey-blue-100); box-shadow: var(--valkey-shadow-card); }
  .post-card h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .post-card h3 a { color: var(--valkey-text); }
  .post-card h3 a:hover { color: var(--valkey-link); text-decoration: none; }
  .excerpt { color: var(--valkey-text-light); font-size: 0.9rem; line-height: 1.5; margin: 0; }
</style>
