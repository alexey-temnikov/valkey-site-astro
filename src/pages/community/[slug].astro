---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { communityCards } from "../../data/community";

export async function getStaticPaths() {
  const pages = import.meta.glob("/src/content/community/*.md", { eager: true });
  return Object.entries(pages)
    .filter(([path]) => !path.endsWith("/_index.md"))
    .map(([path, mod]: [string, any]) => {
      const slug = path.split("/").pop()!.replace(".md", "");
      return { params: { slug }, props: { frontmatter: mod.frontmatter, Content: mod.default } };
    });
}

const { frontmatter, Content } = Astro.props;

// Merge page-specific cards with global cards
const pageCards = frontmatter.cards ?? [];
const allCards = [...pageCards, ...communityCards];
---

<MarketingLayout title={`${frontmatter.title} · Valkey`} description={frontmatter.description}>
  <section class="community-page width-limiter">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/community/">Community</a> <span class="sep">›</span>
      <span aria-current="page">{frontmatter.title}</span>
    </nav>

    <div class="prose">
      <Content />
    </div>

    {allCards.length > 0 && (
      <div class="community-card-grid">
        {allCards.map((card: any) => (
          <div class="community-card">
            <img src={`/img/${card.icon}`} alt={card.title} class="community-card-icon" />
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <div class="community-card-actions">
              {card.links.map((link: any) => (
                <a href={link.url} class="btn" target="_blank" rel="noopener">{link.text}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <footer class="post-footer">
      <a href="/community/" class="back">← Back to community</a>
    </footer>
  </section>
</MarketingLayout>

<style>
  .community-page { max-width: 900px; padding: 2rem 1.5rem 5rem; }
  .prose :global(h1) { font-family: var(--valkey-cond); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin: 0.5rem 0 1rem; }
  .community-card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0; }
  .community-card { border: 1px solid var(--valkey-line); border-radius: 10px; padding: 1.5rem; background: var(--valkey-bg-elevated); }
  .community-card-icon { width: 40px; height: 40px; margin-bottom: 0.75rem; }
  .community-card h3 { margin: 0 0 0.5rem; font-size: 1.1rem; color: var(--valkey-text-strong); }
  .community-card p { color: var(--valkey-text-light); font-size: 0.9rem; line-height: 1.5; }
  .community-card-actions { margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--valkey-blue-300); color: var(--valkey-on-accent); padding: 0.4rem 0.9rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; }
</style>
