---
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const sections = [
  {
    title: "Documentation by Topic",
    description:
      "Task-oriented guides covering install, configuration, replication, security, benchmarking, and more.",
    button: "Browse topics →",
    href: "/topics/",
  },
  {
    title: "Command Reference",
    description:
      "Every Valkey command with usage, complexity, RESP2/3 replies, and examples. Includes first-party modules (Bloom, JSON, Search).",
    button: "Browse commands →",
    href: "/commands/",
  },
  {
    title: "Client Libraries",
    description:
      "Official and community Valkey clients across every major language.",
    button: "See clients →",
    href: "/clients/",
  },
  {
    title: "Valkey GLIDE",
    description:
      "The General Language Independent Driver for the Enterprise — one Rust core, many languages.",
    button: "GLIDE docs →",
    href: "/glide/",
  },
];
---

<MarketingLayout
  title="Documentation · Valkey"
  description="Valkey documentation hub: topics, command reference, client libraries, and GLIDE."
>
  <section class="width-limiter docs-hub">
    <header>
      <h1 class="page-h1">Valkey Documentation</h1>
      <p class="lead">
        Everything you need to build with Valkey — from quick-start guides to
        the full command reference and client libraries.
      </p>
    </header>

    <div class="hub-grid">
      {sections.map((s) => (
        <a class="hub-card" href={s.href}>
          <h2>{s.title}</h2>
          <p>{s.description}</p>
          <span class="card-button">{s.button}</span>
        </a>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .docs-hub {
    padding: 4rem 1.5rem 5rem;
  }
  .docs-hub .lead {
    color: var(--valkey-text-light);
    font-size: 1.1rem;
    max-width: 52rem;
    margin: 0 0 3rem;
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .hub-card {
    display: block;
    border: 1px solid var(--valkey-line);
    border-radius: 12px;
    padding: 1.75rem;
    background: var(--valkey-bg-elevated);
    color: inherit;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .hub-card:hover {
    text-decoration: none;
    border-color: var(--valkey-blue-100);
    box-shadow: var(--valkey-shadow-card);
  }
  .hub-card h2 {
    margin: 0 0 0.5rem;
    color: var(--valkey-text-strong);
    font-size: 1.3rem;
  }
  .hub-card p {
    color: var(--valkey-text-light);
    margin: 0 0 1rem;
  }
  .card-button {
    color: var(--valkey-link);
    font-weight: 600;
  }
</style>
