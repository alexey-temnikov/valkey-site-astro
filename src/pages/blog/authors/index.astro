---
import MarketingLayout from "../../../layouts/MarketingLayout.astro";

const authorFiles = import.meta.glob("/src/content/authors/*.md", { eager: true });
const authors = Object.entries(authorFiles)
  .map(([path, mod]: [string, any]) => {
    const handle = path.split("/").pop()!.replace(".md", "");
    const fm = mod.frontmatter ?? {};
    return { handle, name: fm.name ?? handle, image: fm.image ?? "" };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<MarketingLayout title="Authors – Valkey Blog">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Blog Authors</h1>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {authors.map((a) => (
        <a href={`/blog/authors/${a.handle}/`} class="flex flex-col items-center text-center group">
          <img
            src={a.image || "/img/valkey-logo-og.png"}
            alt={a.name}
            class="w-20 h-20 rounded-full object-cover mb-2 group-hover:ring-2 ring-indigo-500"
          />
          <span class="text-sm font-medium group-hover:text-indigo-600">{a.name}</span>
        </a>
      ))}
    </div>
  </main>
</MarketingLayout>
