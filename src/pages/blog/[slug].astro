---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import AuthorBios from "../../components/AuthorBios.astro";
import { getCollection, render } from "astro:content";
import { postSlug, formatPostDate } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  return sorted.map((post, i) => {
    const slug = post.data.slug ?? post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
    return {
      params: { slug },
      props: {
        post,
        newer: sorted[i - 1] ?? null,
        older: sorted[i + 1] ?? null,
      },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// Resolve author handles to real names for the top-of-post byline. Each
// author has a canonical record in the `authors` content collection; we
// fall back to the handle if the record is missing so the post still
// renders.
const handles: string[] = post.data.authors ?? [];
const allAuthors = await getCollection("authors");
const nameByHandle = new Map(allAuthors.map((a) => [a.id, a.data.name]));
const resolvedAuthors = handles.map((h) => ({
  handle: h,
  name: nameByHandle.get(h) ?? h,
}));

const pageUrl = `${Astro.site ?? "https://valkey.io"}${Astro.url.pathname}`;
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
---

<MarketingLayout
  title={`${post.data.title} · Valkey Blog`}
  description={post.data.description}
>
  <article class="blog-post width-limiter">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/blog/">Blog</a> <span class="sep">›</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    {post.data.heroImage && (
      <img src={post.data.heroImage} alt="" class="hero-image" />
    )}

    <header>
      {post.data.types[0] && <span class="badge">{post.data.types[0]}</span>}
      <h1>{post.data.title}</h1>
      <p class="meta">{formatPostDate(post.data.pubDate, "long")}</p>
    </header>

    {resolvedAuthors.length > 0 && (
      <div class="author-block">
        <span class="author-label">By</span>
        {resolvedAuthors.map(({ handle, name }, i: number) => (
          <>
            <a class="author-name" href={`/authors/${handle}/`}>{name}</a>
            {i < resolvedAuthors.length - 1 && <span class="author-sep">, </span>}
          </>
        ))}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <AuthorBios authors={handles} />

    <div class="share-links">
      <span class="share-label">Share on:</span>
      <a
        href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`}
        target="_blank"
        rel="noopener noreferrer"
      >Twitter/X</a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
        target="_blank"
        rel="noopener noreferrer"
      >LinkedIn</a>
      <a
        href={`https://mastodonshare.com/?url=${shareUrl}&text=${shareTitle}`}
        target="_blank"
        rel="noopener noreferrer"
      >Mastodon</a>
      <a
        href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}
      >Email</a>
    </div>

    <nav class="prev-next" aria-label="Post navigation">
      {newer && (
        <a href={`/blog/${postSlug(newer)}/`} class="nav-newer">
          ← {newer.data.title}
        </a>
      )}
      {older && (
        <a href={`/blog/${postSlug(older)}/`} class="nav-older">
          {older.data.title} →
        </a>
      )}
    </nav>

    <footer class="post-footer">
      <a href="/blog/" class="back">← Back to blog</a>
    </footer>
  </article>
</MarketingLayout>

<style>
  .blog-post {
    max-width: 780px;
    padding: 2rem 1.5rem 5rem;
  }
  .hero-image {
    width: 100%;
    border-radius: 10px;
    margin: 0 0 2rem;
    aspect-ratio: 16/9;
    object-fit: cover;
  }
  .blog-post header h1 {
    font-family: var(--valkey-cond);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0.5rem 0 0.5rem;
    color: var(--valkey-text);
  }
  .meta {
    color: var(--valkey-text-light);
    font-size: 0.95rem;
    margin: 0;
  }
  .author-block {
    margin: 0.75rem 0 2rem;
    font-size: 0.95rem;
    color: var(--valkey-text-light);
  }
  .author-name {
    font-weight: 600;
    color: var(--valkey-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s ease, color 0.2s ease;
  }
  a.author-name:hover {
    color: var(--valkey-link);
    border-bottom-color: currentColor;
  }
  .blog-post .prose {
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .share-links {
    margin-top: 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--valkey-line);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .share-label {
    font-weight: 600;
    color: var(--valkey-text);
  }
  .share-links a {
    color: var(--valkey-link);
    text-decoration: none;
    font-weight: 500;
  }
  .share-links a:hover {
    text-decoration: underline;
  }
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--valkey-line);
    font-size: 0.9rem;
  }
  .nav-newer {
    color: var(--valkey-link);
    font-weight: 500;
    text-align: left;
    max-width: 45%;
  }
  .nav-older {
    color: var(--valkey-link);
    font-weight: 500;
    text-align: right;
    max-width: 45%;
    margin-left: auto;
  }
</style>
