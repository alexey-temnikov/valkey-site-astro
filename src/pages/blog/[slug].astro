---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  return sorted.map((post, i) => {
    const slug = post.data.slug ?? post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
    return {
      params: { slug },
      props: {
        post,
        newer: sorted[i - 1] ?? null,
        older: sorted[i + 1] ?? null,
      },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}

function postSlug(p: any) {
  return p.data.slug ?? p.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
}

// TODO: When src/content/authors collection is created, import and look up
// author full names here. For now, display the handle as-is.
const authors = post.data.authors ?? [];

const pageUrl = `${Astro.site ?? "https://valkey.io"}${Astro.url.pathname}`;
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
---

<MarketingLayout
  title={`${post.data.title} · Valkey Blog`}
  description={post.data.description}
>
  <article class="blog-post width-limiter">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/blog/">Blog</a> <span class="sep">›</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    {post.data.heroImage && (
      <img src={post.data.heroImage} alt="" class="hero-image" />
    )}

    <header>
      {post.data.types[0] && <span class="badge">{post.data.types[0]}</span>}
      <h1>{post.data.title}</h1>
      <p class="meta">{formatDate(post.data.pubDate)}</p>
    </header>

    {authors.length > 0 && (
      <div class="author-block">
        <span class="author-label">By</span>
        {authors.map((handle: string, i: number) => (
          <>
            {/* TODO: look up full name from authors collection when available */}
            <span class="author-name">{handle}</span>
            {i < authors.length - 1 && <span class="author-sep">, </span>}
          </>
        ))}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="share-links">
      <span class="share-label">Share on:</span>
      <a
        href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`}
        target="_blank"
        rel="noopener noreferrer"
      >Twitter/X</a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
        target="_blank"
        rel="noopener noreferrer"
      >LinkedIn</a>
      <a
        href={`https://mastodonshare.com/?url=${shareUrl}&text=${shareTitle}`}
        target="_blank"
        rel="noopener noreferrer"
      >Mastodon</a>
      <a
        href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}
      >Email</a>
    </div>

    <nav class="prev-next" aria-label="Post navigation">
      {newer && (
        <a href={`/blog/${postSlug(newer)}/`} class="nav-newer">
          ← {newer.data.title}
        </a>
      )}
      {older && (
        <a href={`/blog/${postSlug(older)}/`} class="nav-older">
          {older.data.title} →
        </a>
      )}
    </nav>

    <footer class="post-footer">
      <a href="/blog/" class="back">← Back to blog</a>
    </footer>
  </article>
</MarketingLayout>

<style>
  .blog-post {
    max-width: 780px;
    padding: 2rem 1.5rem 5rem;
  }
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--valkey-text-light);
    margin-bottom: 1.5rem;
  }
  .breadcrumbs a {
    color: var(--valkey-blue-300);
  }
  .breadcrumbs .sep {
    margin: 0 0.4rem;
    color: var(--valkey-line);
  }
  .hero-image {
    width: 100%;
    border-radius: 10px;
    margin: 0 0 2rem;
    aspect-ratio: 16/9;
    object-fit: cover;
  }
  .blog-post header h1 {
    font-family: var(--valkey-cond);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0.5rem 0 0.5rem;
    color: var(--valkey-text);
  }
  .meta {
    color: var(--valkey-text-light);
    font-size: 0.95rem;
    margin: 0;
  }
  .badge {
    display: inline-block;
    background: var(--valkey-purple-300);
    color: #fff;
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .author-block {
    margin: 0.75rem 0 2rem;
    font-size: 0.95rem;
    color: var(--valkey-text-light);
  }
  .author-name {
    font-weight: 600;
    color: var(--valkey-text);
  }
  .prose {
    line-height: 1.7;
    font-size: 1.02rem;
  }
  .prose :global(h2) {
    font-family: var(--valkey-cond);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--valkey-deep-blue);
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    color: var(--valkey-text);
    margin-top: 1.75rem;
  }
  .prose :global(pre) {
    background: #1e1e2e;
    color: #f5f5f5;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--valkey-mono);
    font-size: 0.85rem;
  }
  .prose :global(p code),
  .prose :global(li code) {
    background: var(--valkey-bg-soft);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--valkey-line);
    font-size: 0.9em;
    font-family: var(--valkey-mono);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--valkey-blue-200);
    padding: 0.5rem 1rem;
    background: var(--valkey-bg-soft);
    border-radius: 0 8px 8px 0;
    margin: 1rem 0;
  }
  .share-links {
    margin-top: 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--valkey-line);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .share-label {
    font-weight: 600;
    color: var(--valkey-text);
  }
  .share-links a {
    color: var(--valkey-blue-300);
    text-decoration: none;
    font-weight: 500;
  }
  .share-links a:hover {
    text-decoration: underline;
  }
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--valkey-line);
    font-size: 0.9rem;
  }
  .nav-newer {
    color: var(--valkey-blue-300);
    font-weight: 500;
    text-align: left;
    max-width: 45%;
  }
  .nav-older {
    color: var(--valkey-blue-300);
    font-weight: 500;
    text-align: right;
    max-width: 45%;
    margin-left: auto;
  }
  .post-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--valkey-line);
  }
  .back {
    color: var(--valkey-blue-300);
    font-weight: 600;
  }
</style>
