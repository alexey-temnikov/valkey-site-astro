---
/**
 * Valkey landing page — editorial-technical design.
 *
 * Aesthetic direction (committed, not incremental):
 *   Swiss editorial × monospace instrumentation × Bauhaus color blocks.
 *   The page *looks like* a database — sector IDs, tabular numerals,
 *   live terminal, thin hairlines, deep-blue mass, pacific-sky accents.
 *
 * Section layout:
 *   § 01  HERO          — grid-broken split: headline + live terminal
 *   § 02  DISPATCH      — masthead release + 2 staggered tear-outs + metrics
 *   § 03  DIRECTORY     — four-sector documentation grid
 *   § 04  CONSORTIUM    — restyled carousel (pacific-sky band)
 *
 * Components:
 *   - ValkeyTerminal   — animated valkey-cli session (inline script, no
 *                        hydration cost, IO-paused when off-screen)
 *   - HeroMetrics      — instrument-panel tiles with SVG sparklines
 *   - DocDirectory     — editorial doc grid with sector IDs
 *   - ParticipantsStrip — reskinned participants row; reuses carousel.js
 *
 * Motion:
 *   - IntersectionObserver staggered reveal (180 ms cascade)
 *   - Terminal typing at 22-50 ms per char
 *   - All motion disabled under prefers-reduced-motion
 */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import ReleaseCard from "../components/ReleaseCard.astro";
import ValkeyTerminal from "../components/ValkeyTerminal.astro";
import HeroMetrics from "../components/HeroMetrics.astro";
import DocDirectory from "../components/DocDirectory.astro";
import ParticipantsStrip from "../components/ParticipantsStrip.astro";
import { parseReleases, latestPerMajor } from "../lib/releases";
import { dashboards as perfDashboards } from "../data/perf";
import { getCollection } from "astro:content";
import participants from "../data/participants.json";
import { marked } from "marked";

// --- Release data ---
const releaseModules = import.meta.glob("/src/content/releases/*.md", { eager: true }) as Record<
  string,
  { frontmatter: Record<string, any> }
>;
const allReleases = parseReleases(releaseModules);
const latestReleases = latestPerMajor(allReleases);
const [newestRelease, ...pastMajorReleases] = latestReleases;
const latestMajor = newestRelease ? newestRelease.tag.split(".")[0] : "8";

// --- Blog posts ---
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// --- Topics + commands counts (real data powering the instrument tiles) ---
const topics = await getCollection("docs");
const topicCount = topics.filter((t) => t.id.startsWith("topics/")).length;

// --- Doc directory items (the 4 editorial sectors) ---
const docItems = [
  {
    title: "Install",
    kicker: "For first-time operators.",
    description:
      "Binary, source, and container-registry quick starts. Get a running server in under a minute on macOS, Linux, or Docker.",
    href: "/topics/installation/",
    chip: "Setup",
  },
  {
    title: "Topics",
    kicker: "The operator's manual.",
    description: `${topicCount} guides covering clustering, replication, persistence, security, scripting, and production deployment.`,
    href: "/topics/",
    chip: "Guide",
  },
  {
    title: "API",
    kicker: "Every command, every reply.",
    description:
      "The complete command reference including RESP2/RESP3 replies, complexity, and first-party module commands.",
    href: "/commands/",
    chip: "Reference",
  },
  {
    title: "Clients",
    kicker: "Official libraries.",
    description: "Drop-in drivers for the languages your stack already speaks.",
    href: "/clients/",
    features: ["Python", "Java", "Go", "Node.js", "PHP", "C#"],
    chip: "SDK",
  },
];

// --- Live instrument tiles (all derived from real content — no marketing fluff) ---
// Sparkline values are intentionally illustrative: they communicate direction,
// not precision, and keep the hero feeling instrumented rather than static.
const metricTiles = [
  {
    label: "Throughput",
    value: "1M+",
    unit: "rps",
    caption: "Per node, single-shard. c8g.metal-48xl.",
    spark: [32, 38, 36, 44, 52, 61, 58, 70, 82, 98, 110, 132],
    href: "/performance/",
  },
  {
    label: "Commands",
    value: "436",
    caption: "Core + Bloom + JSON + Search.",
    spark: [210, 218, 240, 265, 290, 320, 355, 380, 401, 420, 428, 436],
    href: "/commands/",
  },
  {
    label: "Topics",
    value: String(topicCount),
    caption: "Guides, tutorials, administration.",
    spark: [12, 18, 22, 28, 31, 38, 44, 51, 58, 66, 72, topicCount],
    href: "/topics/",
  },
  {
    label: "Consortium",
    value: String(participants.length),
    caption: "Maintaining an open BSD datastore.",
    spark: [1, 2, 3, 5, 6, 8, 10, 12, 14, 15, 16, participants.length],
    href: "#consortium",
  },
];

const totalReleasePills = allReleases.length;
---

<MarketingLayout title="Valkey" bodyClass="homepage">
  {/* -----------------------------------------------------------------------
      § 01 HERO — asymmetric split
      ----------------------------------------------------------------------- */}
  <section class="vk-hero" aria-labelledby="vk-hero-heading">
    <div class="vk-hero-noise" aria-hidden="true"></div>
    <div class="vk-hero-frame">
      {/* Meta strip above the headline */}
      <div class="vk-hero-meta">
        <span class="vk-sector">§ 01 / HERO</span>
        <span class="vk-divider" aria-hidden="true">———</span>
        <span class="vk-badge">
          <span class="vk-badge-dot" aria-hidden="true"></span>
          Valkey {latestMajor}.x · Stable
        </span>
        <span class="vk-divider" aria-hidden="true">———</span>
        <span class="vk-meta-note">BSD-3-Clause · Linux Foundation</span>
      </div>

      <div class="vk-hero-grid">
        {/* Left: condensed-caps display headline */}
        <div class="vk-hero-copy">
          <h1 id="vk-hero-heading" class="vk-hero-title">
            <span class="vk-hero-line">Fast.</span>
            <span class="vk-hero-line">Reliable.</span>
            <span class="vk-hero-line vk-hero-line-accent">
              Open
              <span class="vk-hero-em">source</span>,
              <span class="vk-hero-mono">forever</span>.
            </span>
          </h1>
          <p class="vk-hero-subtitle">
            A high-performance key/value datastore for caching, queues, and primary workloads —
            stewarded by an independent community under the Linux Foundation.
          </p>
          <div class="vk-hero-actions">
            <a class="vk-cta vk-cta-primary" href="/topics/quickstart/">
              Get started
              <svg width="18" height="10" viewBox="0 0 18 10" aria-hidden="true">
                <path d="M0 5H14 M10 1l4 4-4 4" fill="none" stroke="currentColor"
                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="vk-cta vk-cta-ghost" href="/download/">
              Download
              <span class="vk-cta-version">v{newestRelease?.tag ?? "8.0"}</span>
            </a>
            <a class="vk-cta-link" href="https://github.com/valkey-io/valkey" rel="noopener">
              <span class="vk-cta-link-inner">github.com/valkey-io/valkey</span>
            </a>
          </div>
        </div>

        {/* Right: animated terminal */}
        <aside class="vk-hero-terminal" aria-label="Valkey command demonstration">
          <div class="vk-hero-terminal-caption" aria-hidden="true">
            <span class="caption-idx">01.A</span>
            <span class="caption-txt">Live demonstration</span>
          </div>
          <ValkeyTerminal />
          <div class="vk-hero-terminal-footer" aria-hidden="true">
            <span>Read more</span>
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M0 10 L10 0 M4 0h6v6" stroke="currentColor" fill="none"
                    stroke-width="1" stroke-linecap="round" />
            </svg>
            <a href="/topics/quickstart/">quickstart ↗</a>
          </div>
        </aside>
      </div>

      {/* Instrument strip */}
      <HeroMetrics tiles={metricTiles} />
    </div>
  </section>

  {/* -----------------------------------------------------------------------
      § 02 DISPATCH — editorial masthead
      ----------------------------------------------------------------------- */}
  <section class="vk-dispatch" aria-labelledby="vk-dispatch-heading">
    <div class="vk-dispatch-frame">
      <header class="vk-dispatch-head">
        <div class="vk-sector-row">
          <span class="vk-sector-alt">§ 02 / DISPATCH</span>
          <span class="vk-sector-sub">Releases · Performance · Writing</span>
        </div>
        <h2 id="vk-dispatch-heading" class="vk-dispatch-title">
          What's new in Valkey.
        </h2>
      </header>

      <div class="vk-dispatch-grid">
        {/* Masthead release card */}
        {newestRelease && (
          <article class="vk-dispatch-lead">
            <div class="vk-dispatch-lead-kicker">
              <span class="kicker-eyebrow">Current release</span>
              <span class="kicker-date">
                {new Date(newestRelease.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            </div>
            <div class="vk-dispatch-version">
              <span class="version-maj">{latestMajor}</span>
              <span class="version-rest">.{newestRelease.tag.split(".").slice(1).join(".")}</span>
            </div>
            <div class="vk-dispatch-accent" aria-hidden="true"></div>
            <div class="vk-dispatch-lead-body">
              <ReleaseCard release={newestRelease} heading="none" />
              {pastMajorReleases.length > 0 && (
                <details class="vk-dispatch-past">
                  <summary>
                    <span class="past-label">Past majors</span>
                    <span class="past-count">
                      {pastMajorReleases.length} older version{pastMajorReleases.length !== 1 ? "s" : ""}
                    </span>
                  </summary>
                  <div class="past-body">
                    {pastMajorReleases.map((r) => <ReleaseCard release={r} heading="major" />)}
                  </div>
                </details>
              )}
            </div>
          </article>
        )}

        {/* Performance tile */}
        <article class="vk-dispatch-perf">
          <div class="vk-dispatch-perf-head">
            <span class="perf-eyebrow">§ 02.A / Performance</span>
            <svg class="perf-chart" viewBox="0 0 240 80" aria-hidden="true">
              <defs>
                <linearGradient id="perf-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--valkey-pacific-sky)" stop-opacity="0.6" />
                  <stop offset="100%" stop-color="var(--valkey-pacific-sky)" stop-opacity="0" />
                </linearGradient>
              </defs>
              {/* sparkline path — hand-tuned so the curve feels like a benchmark */}
              <path
                d="M0,64 L20,58 L40,60 L60,50 L80,46 L100,42 L120,36 L140,30 L160,26 L180,18 L200,14 L220,10 L240,8 L240,80 L0,80 Z"
                fill="url(#perf-fill)"
              />
              <path
                d="M0,64 L20,58 L40,60 L60,50 L80,46 L100,42 L120,36 L140,30 L160,26 L180,18 L200,14 L220,10 L240,8"
                fill="none"
                stroke="var(--valkey-blue-300)"
                stroke-width="1.75"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
              {/* end dot */}
              <circle cx="240" cy="8" r="3" fill="var(--valkey-blue-300)" />
            </svg>
          </div>
          <h3 class="vk-dispatch-perf-title">
            <a href="/performance/">Throughput across versions</a>
          </h3>
          <p class="vk-dispatch-perf-body">
            Release-over-release benchmarks showing sustained throughput gains on
            modern ARM and x86 hardware. Methodology and raw data included.
          </p>
          <a class="vk-dispatch-perf-cta" href="/performance/">
            Open dashboard
            <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true">
              <path d="M0 4H11 M8 1l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.25"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </article>

        {/* Blog tear-outs */}
        <aside class="vk-dispatch-blog" aria-label="Latest blog posts">
          <div class="vk-dispatch-blog-head">
            <span class="blog-eyebrow">§ 02.B / Writing</span>
            <a class="blog-all" href="/blog/">All posts →</a>
          </div>
          <ul class="vk-dispatch-blog-list" role="list">
            {latestPosts.map((post, i) => {
              const slug = post.data.slug || post.id.replace(/\.md$/, "");
              const firstChar = post.data.title.trim().charAt(0);
              return (
                <li class="vk-dispatch-blog-item" style={`--i:${i}`}>
                  <a href={`/blog/${slug}/`}>
                    <span class="blog-dropcap" aria-hidden="true">{firstChar}</span>
                    <div class="blog-body">
                      <time class="blog-date">
                        {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>
                      <h4 class="blog-title">
                        {post.data.title.startsWith(firstChar)
                          ? post.data.title.slice(1)
                          : post.data.title}
                      </h4>
                      {post.data.description && (
                        <p class="blog-excerpt">{post.data.description}</p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {/* -----------------------------------------------------------------------
      § 03 DIRECTORY — editorial 4-sector doc grid
      ----------------------------------------------------------------------- */}
  <section class="vk-docs" aria-labelledby="vk-docs-heading">
    <div class="vk-docs-frame">
      <header class="vk-docs-head">
        <div class="vk-sector-row">
          <span class="vk-sector-alt">§ 03 / DIRECTORY</span>
          <span class="vk-sector-sub">The documentation, by sector</span>
        </div>
        <h2 id="vk-docs-heading" class="vk-docs-title">
          Read the manual,<br />
          <em>ship sooner.</em>
        </h2>
        <p class="vk-docs-lead">
          Valkey runs standalone or clustered, with replication and high availability.
          It speaks <strong>strings</strong>, <strong>hashes</strong>, <strong>lists</strong>,
          <strong>sets</strong>, <strong>sorted sets</strong>, <strong>streams</strong>,
          <strong>bitmaps</strong>, <strong>hyperloglogs</strong>, and more — with in-place
          commands, Lua scripting, and first-party modules to extend the surface.
        </p>
      </header>
      <DocDirectory items={docItems} />
    </div>
  </section>

  {/* -----------------------------------------------------------------------
      § 04 CONSORTIUM — restyled participants carousel
      ----------------------------------------------------------------------- */}
  <div id="consortium">
    <ParticipantsStrip
      participants={participants}
      title="§ 04 / Consortium"
      lead="Valkey participants are vendors, operators, and communities who keep the project independent. They contribute code, run infrastructure, ship clients, and back the Linux Foundation governance that guarantees the BSD license."
    />
  </div>

  {/* Keep the ported carousel behavior — binds to #homepageParticipantsCarousel */}
  <script is:inline src="/assets/js/carousel.js" defer></script>

  {/* Staggered section reveal via IntersectionObserver */}
  <script is:inline>
    (() => {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced) return;
      const targets = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "-40px 0px" },
      );
      targets.forEach((el) => io.observe(el));
    })();
  </script>
</MarketingLayout>

<style>
  /* ======================================================================
     GLOBAL RHYTHM / SHARED ATOMS
     ====================================================================== */
  .vk-sector,
  .vk-sector-alt {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--valkey-pacific-sky, #b9d9eb);
  }
  .vk-sector-alt {
    color: var(--valkey-blue-300, #0055a6);
  }
  .vk-sector-sub {
    font-family: var(--valkey-serif, "Noto Serif", Georgia, serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--valkey-text-light, #647782);
  }
  .vk-sector-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--valkey-line, #ccd3d6);
  }

  /* ======================================================================
     § 01 HERO
     ====================================================================== */
  .vk-hero {
    position: relative;
    background:
      radial-gradient(1200px 600px at 110% -10%, rgba(105, 131, 255, 0.28) 0%, transparent 60%),
      radial-gradient(900px 500px at -10% 10%, rgba(105, 74, 172, 0.18) 0%, transparent 60%),
      linear-gradient(180deg, #041f36 0%, #062742 55%, #031428 100%);
    color: #fff;
    padding: 3.5rem 1.5rem 0;
    overflow: hidden;
    isolation: isolate;
  }
  .vk-hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    pointer-events: none;
    background:
      /* thin horizontal grid */
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 80px
      ),
      /* vertical grid */
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 80px
      );
    mask-image: radial-gradient(ellipse at center, #000 0%, transparent 85%);
    z-index: 0;
  }
  .vk-hero-frame {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    z-index: 1;
  }
  .vk-hero-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    flex-wrap: wrap;
  }
  .vk-hero-meta .vk-divider {
    color: rgba(255, 255, 255, 0.25);
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    letter-spacing: 0.2em;
    font-size: 0.68rem;
  }
  .vk-badge {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: #fff;
    text-transform: uppercase;
  }
  .vk-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7cd1a0;
    box-shadow: 0 0 0 3px rgba(124, 209, 160, 0.2);
    animation: vk-pulse 2.4s ease-in-out infinite;
  }
  @keyframes vk-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(124, 209, 160, 0.2); }
    50%      { box-shadow: 0 0 0 6px rgba(124, 209, 160, 0.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vk-badge-dot { animation: none; }
  }
  .vk-meta-note {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    margin-left: auto;
  }

  .vk-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: start;
    padding: 4rem 0 4.5rem;
  }

  .vk-hero-title {
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.94;
    margin: 0;
    color: #fff;
    font-weight: 700;
  }
  .vk-hero-line {
    display: block;
  }
  .vk-hero-line-accent {
    color: var(--valkey-pacific-sky, #b9d9eb);
  }
  .vk-hero-em {
    font-family: var(--valkey-serif, "Noto Serif", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #fff;
  }
  .vk-hero-mono {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.68em;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    color: #fff;
    padding: 0.05em 0.3em;
    background: var(--valkey-purple-200, #692a84);
    border-radius: 4px;
    vertical-align: 0.06em;
  }

  .vk-hero-subtitle {
    margin: 1.75rem 0 2.25rem;
    font-size: 1.075rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 36rem;
  }

  .vk-hero-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .vk-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.5rem;
    border-radius: 3px;
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1rem;
    font-weight: 700;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
    border: 1px solid transparent;
  }
  .vk-cta-primary {
    background: var(--valkey-pacific-sky, #b9d9eb);
    color: var(--valkey-deep-blue, #003b5c);
  }
  .vk-cta-primary:hover {
    background: #fff;
    transform: translateY(-1px);
    text-decoration: none;
  }
  .vk-cta-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .vk-cta-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
  }
  .vk-cta-version {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    text-transform: none;
    font-weight: 400;
  }
  .vk-cta-link {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    padding: 0.5rem 0;
    margin-left: 0.5rem;
    text-decoration: none;
    position: relative;
  }
  .vk-cta-link-inner {
    border-bottom: 1px dotted rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .vk-cta-link:hover .vk-cta-link-inner {
    color: var(--valkey-pacific-sky, #b9d9eb);
    border-color: var(--valkey-pacific-sky, #b9d9eb);
  }
  .vk-cta-link:hover { text-decoration: none; }

  .vk-hero-terminal {
    position: relative;
  }
  .vk-hero-terminal-caption {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-bottom: 0.55rem;
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .vk-hero-terminal-caption .caption-idx {
    color: var(--valkey-pacific-sky, #b9d9eb);
  }
  .vk-hero-terminal-footer {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.7rem;
    font-family: var(--valkey-mono, "Fira Mono", monospace);
