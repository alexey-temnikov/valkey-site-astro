---
/* Homepage: hero → what's new → docs → participants. */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import WhatsNewSection from "../components/WhatsNewSection.astro";
import DocsCardsSection from "../components/DocsCardsSection.astro";
import ParticipantsStrip from "../components/ParticipantsStrip.astro";
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
const participants = yaml.load(
  fs.readFileSync(path.resolve("src/data/participants.yml"), "utf8"),
) as any[];
---

<MarketingLayout title="Valkey" bodyClass="homepage">
  <HomeHero />
  <WhatsNewSection />
  <DocsCardsSection />

  <div id="participants">
    <ParticipantsStrip
      participants={participants}
      title="Participants"
      lead="Valkey participants are vendors, operators, and communities who keep the project independent. They contribute code, run infrastructure, ship client libraries, and back the Linux Foundation governance that guarantees the BSD license."
    />
  </div>

  <script is:inline src="/assets/js/carousel.js" defer></script>

  <script is:inline>
    (() => {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced) return;
      const targets = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "-40px 0px" },
      );
      targets.forEach((el) => io.observe(el));
    })();
  </script>
</MarketingLayout>

<style>
  :global(.homepage .page-subhead) { display: none; }
</style>
