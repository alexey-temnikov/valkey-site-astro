---
/**
 * Valkey landing page — keeps the original valkey.io color palette and
 * visual rhythm (deep-purple hero, periwinkle docs band, frosted what's-new,
 * purple consortium) while layering in modern UX: live instrumentation,
 * animated terminal, refined hover states, staggered section reveals.
 *
 * Reference palette used throughout (ported from sass/_valkey.scss):
 *   Hero bg        : #30186e + img/hero-bg.webp with a 0.15→0.75 overlay
 *   Docs section   : #6983FF (periwinkle) with white text, dark-purple cards
 *   Cards          : #2d2471 solid with white CTA pill
 *   What's new     : rgb(48,23,110) → rgb(105,131,255) vertical gradient
 *                    inner container rgba(255,255,255,0.2) frosted
 *   Consortium     : rgb(105,131,255) → #bcb5e7 vertical gradient
 *
 * No sector IDs, no editorial "§" labels, no drop-caps — those are
 * recalibrated out because they pulled the page away from the brand.
 */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import ReleaseCard from "../components/ReleaseCard.astro";
import HeroMetrics from "../components/HeroMetrics.astro";
import ParticipantsStrip from "../components/ParticipantsStrip.astro";
import { parseReleases, latestPerMajor } from "../lib/releases";
import { dashboards as perfDashboards } from "../data/perf";
import { getCollection } from "astro:content";
import participants from "../data/participants.json";
import { marked } from "marked";

// --- Release data ---
const releaseModules = import.meta.glob("/src/content/releases/*.md", { eager: true }) as Record<
  string,
  { frontmatter: Record<string, any> }
>;
const allReleases = parseReleases(releaseModules);
const latestReleases = latestPerMajor(allReleases);
const [newestRelease, ...pastMajorReleases] = latestReleases;
const latestMajor = newestRelease ? newestRelease.tag.split(".")[0] : "8";

// --- Blog posts ---
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// --- Topics + commands counts (real data powering the instrument tiles) ---
const topics = await getCollection("docs");
const topicCount = topics.filter((t) => t.id.startsWith("topics/")).length;

// --- Documentation cards (verbatim from the reference content/_index.md) ---
const docCards = [
  {
    title: "Install",
    description:
      "Step-by-step instructions on how to install and configure Valkey for first-time users.",
    button: "See Installation Guide",
    href: "/topics/installation/",
  },
  {
    title: "Usage guide",
    description:
      "Detailed documentation on the various datatypes supported by Valkey and best practices.",
    button: "Documentation by topic",
    href: "/topics/",
  },
  {
    title: "Valkey API",
    description: "View the full list of Valkey commands including first-party modules.",
    button: "Command Reference",
    href: "/commands/",
  },
  {
    title: "Clients",
    description: "Official Valkey client libraries include support for:",
    features: ["Python", "Java", "Go", "Node.js", "PHP", "C#"],
    button: "Learn More",
    href: "/clients/",
  },
];

// --- Live instrument tiles (brand-aligned, real site data) ---
const metricTiles = [
  {
    label: "Throughput",
    value: "1M+",
    unit: "rps",
    caption: "Per node, single shard.",
    spark: [32, 38, 36, 44, 52, 61, 58, 70, 82, 98, 110, 132],
    href: "/performance/",
  },
  {
    label: "Commands",
    value: "436",
    caption: "Core + Bloom + JSON + Search.",
    spark: [210, 218, 240, 265, 290, 320, 355, 380, 401, 420, 428, 436],
    href: "/commands/",
  },
  {
    label: "Topics",
    value: String(topicCount),
    caption: "Guides, tutorials, admin.",
    spark: [12, 18, 22, 28, 31, 38, 44, 51, 58, 66, 72, topicCount],
    href: "/topics/",
  },
  {
    label: "Participants",
    value: String(participants.length),
    caption: "Backing the Linux Foundation project.",
    spark: [1, 2, 3, 5, 6, 8, 10, 12, 14, 15, 16, participants.length],
    href: "#participants",
  },
];
---

<MarketingLayout title="Valkey" bodyClass="homepage">
  {/* ================================================================
      HERO — centered, matches the original valkey.io structure.
      Background: #30186e + img/hero-bg.webp + rgba(48,24,110,0.15→0.75).
      A small instrument strip sits below the hero copy.
      ================================================================ */}
  <section class="vk-hero">
    <div class="vk-hero-inner">
      <div class="vk-hero-copy">
        <h1 class="vk-hero-heading">FAST. RELIABLE.</h1>
        <h1 class="vk-hero-heading">OPEN SOURCE, FOREVER.</h1>
        <p class="vk-hero-subtitle">
          Valkey is an open source (BSD) high-performance key/value datastore that
          supports a variety of workloads such as caching, message queues, and can
          act as a primary database. The project is backed by the Linux Foundation,
          ensuring it will remain open source forever.
        </p>
        <div class="vk-hero-ctas">
          <a class="vk-hero-button" href="/topics/quickstart/">GET STARTED</a>
          <a class="vk-hero-link" href="/download/">
            <span>Download v{newestRelease?.tag ?? "8.0"}</span>
            <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
              <path d="M0 5h11 M8 1l3 4-3 4" fill="none" stroke="currentColor"
                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* Instrument strip — lives inside the hero region, below the copy */}
    <div class="vk-hero-metrics-wrap">
      <HeroMetrics tiles={metricTiles} />
    </div>
  </section>

  {/* ================================================================
      WHAT'S NEW — preserves the original purple gradient and frosted
      inner container. Adds a 2-column layout with release masthead,
      performance panel, and a clean blog-post list.
      ================================================================ */}
  <section class="vk-whats-new" aria-labelledby="vk-whats-new-heading">
    <div class="vk-whats-new-wrap">
      <h2 id="vk-whats-new-heading" class="vk-whats-new-heading">What's new</h2>

      <div class="vk-whats-new-inner">
        {/* Release masthead + past-majors accordion */}
        {newestRelease && (
          <article class="vk-wn-release">
            <div class="vk-wn-release-meta">
              <span class="meta-label">Current release</span>
              <time>
                {new Date(newestRelease.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>
            <div class="vk-wn-release-version">
              <span class="v-major">{latestMajor}</span>
              <span class="v-rest">.{newestRelease.tag.split(".").slice(1).join(".")}</span>
            </div>
            <div class="vk-wn-release-card">
              <ReleaseCard release={newestRelease} heading="none" />
            </div>
            {pastMajorReleases.length > 0 && (
              <details class="vk-wn-past">
                <summary>
                  <span>Past major releases</span>
                  <span class="past-count">
                    {pastMajorReleases.length} older version{pastMajorReleases.length !== 1 ? "s" : ""}
                  </span>
                </summary>
                <div class="past-body">
                  {pastMajorReleases.map((r) => <ReleaseCard release={r} heading="major" />)}
                </div>
              </details>
            )}
          </article>
        )}

        {/* Performance + Blog in a stacked right column */}
        <aside class="vk-wn-side">
          <article class="vk-wn-perf">
            <h3>Performance</h3>
            {perfDashboards.map((d) => (
              <div class="vk-wn-perf-inner">
                <h4>
                  <a href={d.link} set:html={marked.parseInline(d.title, { async: false })} />
                </h4>
                <div class="vk-wn-perf-desc" set:html={marked.parse(d.description, { async: false })} />
                {/* Mini sparkline visualizes "throughput across versions" */}
                <svg class="vk-wn-perf-chart" viewBox="0 0 260 60" aria-hidden="true">
                  <defs>
                    <linearGradient id="perfFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#fff" stop-opacity="0.55" />
                      <stop offset="100%" stop-color="#fff" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M0,48 L20,44 L40,46 L60,40 L80,36 L100,32 L120,26 L140,22 L160,18 L180,12 L200,10 L220,8 L240,6 L260,4 L260,60 L0,60 Z"
                    fill="url(#perfFill)"
                  />
                  <path
                    d="M0,48 L20,44 L40,46 L60,40 L80,36 L100,32 L120,26 L140,22 L160,18 L180,12 L200,10 L220,8 L240,6 L260,4"
                    fill="none"
                    stroke="#fff"
                    stroke-width="1.75"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />
                  <circle cx="260" cy="4" r="3" fill="#fff" />
                </svg>
                <a href={d.link} class="vk-wn-perf-cta">
                  Explore
                  <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true">
                    <path d="M0 4h11 M8 1l3 3-3 3" fill="none" stroke="currentColor"
                          stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            ))}
          </article>

          <article class="vk-wn-blog">
            <div class="vk-wn-blog-head">
              <h3>Latest posts</h3>
              <a class="vk-wn-blog-all" href="/blog/">All posts</a>
            </div>
            <ul class="vk-wn-blog-list" role="list">
              {latestPosts.map((post) => {
                const slug = post.data.slug || post.id.replace(/\.md$/, "");
                return (
                  <li class="vk-wn-blog-item">
                    <a href={`/blog/${slug}/`}>
                      <time>
                        {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>
                      <h4>{post.data.title}</h4>
                      {post.data.description && <p>{post.data.description}</p>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </article>
        </aside>
      </div>
    </div>
  </section>

  {/* ================================================================
      DOCUMENTATION — periwinkle #6983FF background, white text,
      dark-purple #2d2471 cards, rounded-pill CTAs — exactly matches
      the original visual grammar, with refined card interactions.
      ================================================================ */}
  <section class="vk-docs" aria-labelledby="vk-docs-heading">
    <div class="vk-docs-wrap">
      <h2 id="vk-docs-heading" class="vk-docs-heading">Documentation</h2>
      <p class="vk-docs-lead">
        Valkey can run as either a <strong>standalone</strong> daemon or in a
        <strong>cluster</strong>, with options for <strong>replication</strong>
        and <strong>high availability</strong>. Valkey natively supports a rich
        collection of datatypes, including <strong>strings</strong>,
        <strong>numbers</strong>, <strong>hashes</strong>,
        <strong>lists</strong>, <strong>sets</strong>,
        <strong>sorted sets</strong>, <strong>bitmaps</strong>,
        <strong>hyperloglogs</strong> and more. You can operate on data
        structures in-place with an expressive collection of commands. Valkey
        also supports native extensibility with built-in scripting support for
        <strong>Lua</strong> and supports <strong>module</strong> plugins to
        create new commands, data types, and more.
      </p>
      <ul class="vk-docs-cards" role="list">
        {docCards.map((c) => (
          <li class="vk-docs-card">
            <a href={c.href}>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              {c.features && (
                <ul class="vk-docs-features">
                  {c.features.map((f) => <li>{f}</li>)}
                </ul>
              )}
              <span class="vk-docs-cta">
                {c.button}
                <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
                  <path d="M0 5h11 M8 1l3 4-3 4" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================
      PARTICIPANTS — restyled carousel (now aligned back to the brand
      periwinkle→lavender gradient) with a white card surface and the
      hover grayscale-to-color reveal.
      ================================================================ */}
  <div id="participants">
    <ParticipantsStrip
      participants={participants}
      title="Participants"
      lead="Valkey participants are vendors, operators, and communities who keep the project independent. They contribute code, run infrastructure, ship client libraries, and back the Linux Foundation governance that guarantees the BSD license."
    />
  </div>

  {/* Ported carousel behavior — binds to #homepageParticipantsCarousel */}
  <script is:inline src="/assets/js/carousel.js" defer></script>

  {/* Staggered section reveal */}
  <script is:inline>
    (() => {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced) return;
      const targets = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "-40px 0px" },
      );
      targets.forEach((el) => io.observe(el));
    })();
  </script>
</MarketingLayout>

<style>
  /* ======================================================================
     HERO — original deep-purple background + image, now with a terminal
     on the right and an instrument strip below. The gradient overlay
     values (0.15→0.75) and deep purple base (#30186e) match the Zola
     reference pixel-for-pixel.
     ====================================================================== */
  .vk-hero {
    position: relative;
    background:
      linear-gradient(to bottom, rgba(48, 24, 110, 0.15), rgba(48, 24, 110, 0.75)),
      url("/img/hero-bg.webp") right center / cover no-repeat,
      #30186e;
    color: #fff;
    overflow: hidden;
    padding: 3rem 1.5rem 0;
    isolation: isolate;
  }
  .vk-hero::after {
    /* bottom fade — matches original .hero-section::after */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(48, 24, 110, 0) 60%, rgba(48, 24, 110, 1) 100%);
    pointer-events: none;
    z-index: 0;
  }
  .vk-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 0 3rem;
    text-align: center;
  }

  .vk-hero-copy { text-align: center; }
  .vk-hero-heading {
    /* Matches the reference sass/_valkey.scss exactly:
         body + h1-h6 both @include sans-serif = "Open Sans".
         .hero-heading sets font-weight 700, size 4rem mobile → 7rem
         desktop (@ 10px base = 40px → 70px), letter-spacing 2px,
         line-height 1. We convert to browser-default rem units. */
    font-family: var(--valkey-sans, "Open Sans", "Segoe UI", Tahoma, sans-serif);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.5vw, 4.375rem); /* 40px → 70px */
    line-height: 1;
    letter-spacing: 0.03em; /* ≈ 2px at 70px */
    margin: 0;
    color: #fff;
    text-transform: uppercase;
  }
  .vk-hero-heading + .vk-hero-heading { margin-top: 0.15rem; }
  .vk-hero-subtitle {
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.6;
    max-width: 46rem;
    margin: 1.5rem auto 2rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .vk-hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .vk-hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2.5rem;
    border-radius: 999px;
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6983ff;
    /* Signature white→lavender CTA gradient from the original reference */
    background-image: linear-gradient(to right, #ffffff, #b7c2f7);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .vk-hero-button:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .vk-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.15s ease, gap 0.2s ease;
  }
  .vk-hero-link:hover {
    text-decoration: none;
    border-color: #fff;
    gap: 0.75rem;
  }
  .vk-hero-terminal-wrap { display: none; }

  /* Instrument strip — lives just below the hero content, above the
     section-boundary fade, in the original purple context. */
  .vk-hero-metrics-wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0 1rem;
  }

  @media (max-width: 960px) {
    .vk-hero-inner {
      padding: 2.5rem 0 3rem;
    }
    .vk-hero-subtitle { margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 560px) {
    .vk-hero { padding: 3rem 1rem 0; }
    .vk-hero-ctas { gap: 1rem; }
    .vk-hero-button { padding: 0.85rem 1.75rem; font-size: 1.1rem; }
  }

  /* ======================================================================
     WHAT'S NEW — purple gradient + frosted inner container
     ====================================================================== */
  .vk-whats-new {
    background-image: linear-gradient(rgb(48, 23, 110), rgb(105, 131, 255));
    padding: 5rem 1.5rem 5.5rem;
    color: #fff;
  }
  .vk-whats-new-wrap { max-width: 1200px; margin: 0 auto; }
  .vk-whats-new-heading {
    margin: 0 0 2.5rem;
    text-align: center;
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-weight: 700;
    color: #fff;
  }

  .vk-whats-new-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  @media (max-width: 900px) {
    .vk-whats-new-inner {
      grid-template-columns: 1fr;
      padding: 1.75rem;
      gap: 1.5rem;
    }
  }

  /* Release masthead */
  .vk-wn-release {
    background: #fff;
    border-radius: 14px;
    padding: 1.75rem;
    color: var(--valkey-text, #002a3a);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .vk-wn-release-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--valkey-text-light, #647782);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    margin-bottom: 0.25rem;
  }
  .vk-wn-release-meta .meta-label { color: var(--valkey-blue-300, #0055a6); font-weight: 600; }
  .vk-wn-release-version {
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    line-height: 0.9;
    color: var(--valkey-deep-blue, #003b5c);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    margin: 0.25rem 0 1rem;
  }
  .vk-wn-release-version .v-major { font-size: clamp(3.5rem, 7vw, 5.5rem); color: var(--valkey-purple-200, #692a84); }
  .vk-wn-release-version .v-rest {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--valkey-purple-100, #8736aa);
    margin-left: 0.15em;
  }
  .vk-wn-release-card :global(.release-section) { margin: 0; }
  .vk-wn-release-card :global(.release-section h4) {
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1rem;
    color: var(--valkey-deep-blue, #003b5c);
    margin-top: 1.2rem;
  }
  .vk-wn-release-card :global(.release-section p) {
    font-size: 0.92rem;
    margin: 0.4rem 0;
    color: var(--valkey-text, #002a3a);
  }
  .vk-wn-release-card :global(.release-section code) {
    font-family: var(--valkey-mono, "Fira Mono", monospace);
    background: var(--valkey-bg-soft, #f5f7f7);
    border: 1px solid var(--valkey-line, #ccd3d6);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.85em;
  }
  .vk-wn-release-card :global(.release-section hr) {
    margin: 1rem 0;
    border: 0;
    border-top: 1px solid var(--valkey-line, #ccd3d6);
  }
  .vk-wn-release-card :global(.release-section ul) { padding-left: 1.25rem; }

  .vk-wn-past {
    margin-top: 1.5rem;
    border-top: 1px dashed var(--valkey-line, #ccd3d6);
    padding-top: 1.1rem;
  }
  .vk-wn-past summary {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--valkey-blue-300, #0055a6);
    list-style: none;
  }
  .vk-wn-past summary::-webkit-details-marker { display: none; }
  .vk-wn-past summary::after {
    content: "+";
    font-size: 1.35em;
    font-weight: 700;
    transition: transform 0.2s ease;
  }
  .vk-wn-past[open] summary::after { content: "−"; }
  .vk-wn-past .past-count {
    color: var(--valkey-text-light, #647782);
    font-weight: 400;
    font-family: var(--valkey-sans, "Open Sans", sans-serif);
    text-transform: none;
    letter-spacing: 0;
  }
  .vk-wn-past .past-body { margin-top: 1rem; }

  /* Performance + blog stacked right column */
  .vk-wn-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .vk-wn-perf,
  .vk-wn-blog {
    padding: 1.5rem 1.75rem;
    border-radius: 14px;
  }
  .vk-wn-perf {
    background: linear-gradient(160deg, #2d2471 0%, #4b1e5f 100%);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }
  .vk-wn-perf h3 {
    margin: 0 0 0.75rem;
    font-family: var(--valkey-cond, "Open Sans Condensed", Impact, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.25rem;
    font-weight: 700;
