---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { sections } from "../data/perf";
import { marked } from "marked";

const lead =
  "Valkey Performance Dashboards provide a consolidated view of throughput trends across versions, helping teams validate improvements and identify regressions quickly.";
---

<MarketingLayout title="Valkey Performance Dashboards · Valkey" description={lead}>
  <PageHeader title="Valkey Performance Dashboards" />

  <div class="width-limiter">
    <article class="prose performance-page">
      <p class="lead">{lead}</p>

      {sections.map((s) => (
        <section class="performance-section">
          <h2>{s.title}</h2>

          {s.iframe_url && (
            <iframe
              src={s.iframe_url}
              width="100%"
              height="600"
              frameborder="0"
              loading="lazy"
              title={s.title}
            ></iframe>
          )}

          {s.description && (
            <Fragment set:html={marked.parse(s.description, { async: false }) as string} />
          )}

          {s.methodology && (
            <>
              <h3>Methodology</h3>
              <Fragment set:html={marked.parse(s.methodology, { async: false }) as string} />
            </>
          )}
        </section>
      ))}

      <hr />
      <p>
        For questions about performance or to contribute benchmarking data, visit our{" "}
        <a href="/community/">community page</a> or join the discussion on{" "}
        <a href="https://github.com/orgs/valkey-io/discussions">GitHub</a>.
      </p>
    </article>
  </div>
</MarketingLayout>

<style>
  .performance-page {
    padding: 2rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .performance-page .lead {
    font-size: 1.1rem;
    color: var(--valkey-text);
    margin: 0 0 2rem;
  }
  .performance-section {
    margin: 2rem 0 3rem;
  }
  .performance-section iframe {
    display: block;
    width: 100%;
    border: 1px solid var(--valkey-line);
    border-radius: 6px;
    background: var(--valkey-bg-elevated);
    margin-bottom: 1rem;
  }
  .performance-page hr {
    border: 0;
    border-top: 1px solid var(--valkey-line);
    margin: 2rem 0 1.5rem;
  }
</style>
